        def nombres_coinciden(nombre_pac: str, nombre_web: str, umbral=1.0) -> bool:
            a = texto_plano(nombre_pac); b = texto_plano(nombre_web)
            if not a or not b: return False
            ta = {t for t in a.split() if len(t) > 1}
            tb = {t for t in b.split() if len(t) > 1}
            if not ta or not tb: return False
            comunes = len(ta & tb)
            return (comunes / len(ta) >= umbral) and (comunes / len(tb) >= umbral)

        def observacion_coincide(obs_lista: str, obs_web: str, mu_esperado: str = "") -> bool:
            mu_lista = mu_esperado or extraer_mu(obs_lista)
            mu_web = extraer_mu(obs_web)
            if mu_lista:
                return bool(mu_web and mu_coincide(mu_lista, mu_web))
            if not obs_lista.strip(): return True
            lista = texto_plano(obs_lista); web = texto_plano(obs_web)
            return bool(lista and web and (lista in web or web in lista))

        def num_a_ctrl(numero: str) -> str:
            n = str(numero).replace("/", "").strip()
            return f"{n[:6]}/{n[6:]}" if len(n) >= 10 else f"260323/0{n.zfill(3)}"

        def ctrl_coincide(numero_pac: str, ctrl_web: str) -> bool:
            ctrl_web_limpio = str(ctrl_web).strip()
            if not ctrl_web_limpio:
                return True
            ctrl_esperado = num_a_ctrl(numero_pac)
            web_norm = re.sub(r"[\s/]+", "", ctrl_web_limpio).upper()
            esp_norm = re.sub(r"[\s/]+", "", ctrl_esperado).upper()
            coincide = web_norm == esp_norm
