class HistorialWindow:
    def __init__(self, parent, historial: list, etiquetas_fn, eliminar_fn=None):
        self.historial    = historial
        self.etiquetas_fn = etiquetas_fn
        self.eliminar_fn  = eliminar_fn
        self.win = tk.Toplevel(parent)
        self.win.title("Historial de listas ingresadas")
        self.win.geometry("980x560")
        self.win.configure(bg=COLORS["bg"])
        self.win.grab_set()
        self._centrar()
        self._build()

    def _centrar(self):
        maximizar_ventana(self.win)

    def _build(self):
        style_treeview()
        self.win.configure(bg=COLORS["bg"])
        hdr = tk.Frame(self.win, bg=COLORS["bg"], height=70)
        hdr.pack(fill="x", padx=18, pady=(16, 4)); hdr.pack_propagate(False)
        logo_mark(hdr, 42, COLORS["bg"]).pack(side="left", padx=(0, 10), pady=12)
        title = tk.Frame(hdr, bg=COLORS["bg"])
        title.pack(side="left", pady=10)
        tk.Label(title, text="Historial", bg=COLORS["bg"], fg=COLORS["text"],
                 font=(FONT_UI, 18, "bold")).pack(anchor="w")
        self.subtitulo_lbl = tk.Label(title,
                 text=f"{len(self.historial)} listas ingresadas",
                 bg=COLORS["bg"], fg=COLORS["text_muted"],
                 font=(FONT_UI, 9))
        self.subtitulo_lbl.pack(anchor="w")

        frame = styled_card(self.win)
        frame.pack(fill="both", expand=True, padx=18, pady=10)

        cols = ("Lista","Pacientes","Doctor","Obs.","Empresa","Proc.","Hora","PDF")
        self.tabla = ttk.Treeview(frame, columns=cols, show="headings", height=18)
        anchos = {"Lista":190,"Pacientes":75,"Doctor":155,
                  "Obs.":95,"Empresa":70,"Proc.":60,"Hora":130,"PDF":80}
        for c in cols:
            self.tabla.heading(c, text=c)
            self.tabla.column(c, width=anchos[c], anchor="w")

        sb = ttk.Scrollbar(frame, orient="vertical", command=self.tabla.yview)
        self.tabla.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y", padx=(0, 8), pady=12)
        self.tabla.pack(fill="both", expand=True, padx=12, pady=12)

        self._poblar_tabla()

        self.tabla.bind("<Double-1>", self._click_tabla)
        self.tabla.bind("<Button-3>", self._menu_contextual)

        bot = tk.Frame(self.win, bg=COLORS["bg"])
        bot.pack(fill="x", padx=18, pady=(0, 16))
        tk.Button(bot, text="Sacar etiquetas", bg=COLORS["blue"], fg="#FFFFFF",
                  activebackground=COLORS["blue_hover"], activeforeground="#FFFFFF",
                  font=(FONT_UI, 9, "bold"), relief="flat", cursor="hand2",
                  padx=16, pady=9, command=self._sacar_etiquetas).pack(side="left")
        tk.Button(bot, text="Cerrar", command=self.win.destroy,
                  bg=COLORS["bg_surface"], fg=COLORS["text_muted"], relief="flat",
                  activebackground=COLORS["bg_hover"],
                  font=(FONT_UI, 9, "bold"), cursor="hand2",
                  padx=16, pady=9).pack(side="right")

    def _poblar_tabla(self):
        self.tabla.delete(*self.tabla.get_children())
        for h in reversed(self.historial):
            ing  = h.get("ingreso", {})
            meta = h.get("_meta", {})
            ts   = meta.get("timestamp_fin", meta.get("timestamp",""))
            hora = ts[11:19] if len(ts) >= 19 else ts
            ok   = meta.get("resultado",{}).get("ok", h.get("total","?"))
            pdfs = h.get("etiqueta_pdfs") if isinstance(h.get("etiqueta_pdfs"), list) else []
            pdf  = "Ver PDFs" if len(pdfs) > 1 else ("Ver PDF" if h.get("etiqueta_pdf") or pdfs else "-")
            self.tabla.insert("", "end", values=(
                h.get("nombre",""), ok,
                ing.get("doctor",""), ing.get("observacion",""),
                ing.get("empresa",""), ing.get("procedencia",""),
                hora, pdf,
            ))
        self.subtitulo_lbl.config(text=f"{len(self.historial)} listas ingresadas")

    def _click_tabla(self, event):
        col = self.tabla.identify_column(event.x)
        if col != "#8": return
        idx = self._idx_sel()
        if idx is None: return
        h = list(reversed(self.historial))[idx]
        pdfs = h.get("etiqueta_pdfs") if isinstance(h.get("etiqueta_pdfs"), list) else []
        rutas = pdfs or ([h.get("etiqueta_pdf")] if h.get("etiqueta_pdf") else [])
        rutas = [p for p in rutas if p and pathlib.Path(p).exists()]
        if rutas:
            import subprocess, sys
            for pdf_path in rutas:
                if sys.platform == "win32":
                    os.startfile(pdf_path)
                elif sys.platform == "darwin":
                    subprocess.run(["open", pdf_path])
                else:
                    subprocess.run(["xdg-open", pdf_path])
        else:
            messagebox.showinfo("Sin PDF",
                "No hay PDF de etiquetas para esta lista todavía.",
                parent=self.win)

    def _idx_sel(self):
        sel = self.tabla.selection()
        if not sel: return None
        return list(self.tabla.get_children()).index(sel[0])

    def _menu_contextual(self, event):
        row = self.tabla.identify_row(event.y)
        if not row: return
        self.tabla.selection_set(row)
        idx = self._idx_sel()
        if idx is None: return
        h = list(reversed(self.historial))[idx]

        menu = tk.Menu(self.win, tearoff=0,
                       bg=COLORS["bg_surface"], fg=COLORS["text"],
                       activebackground=COLORS["red_soft"],
                       activeforeground=COLORS["red"],
                       font=(FONT_UI, 9))
        menu.add_command(
            label=f"Eliminar  '{h.get('nombre','?')}'",
            command=lambda: self._eliminar_item(idx, h)
        )
        menu.add_separator()
        menu.add_command(
            label="Sacar etiquetas",
            command=self._sacar_etiquetas
        )
        menu.tk_popup(event.x_root, event.y_root)

    def _eliminar_item(self, idx: int, h: dict):
        nombre = h.get("nombre", "esta lista")
        if not messagebox.askyesno(
            "Eliminar del historial",
            f"Eliminar '{nombre}' del historial?\n\n"
            "Se borrara el archivo JSON del disco.\n"
            "Esta accion no se puede deshacer.",
            icon="warning", parent=self.win
        ):
            return

        path_txt = h.get("_historial_path")
        if path_txt:
            try:
                pathlib.Path(path_txt).unlink(missing_ok=True)
            except Exception as e:
                messagebox.showwarning("Advertencia",
                    f"No se pudo borrar el archivo:\n{e}", parent=self.win)

        real_idx = len(self.historial) - 1 - idx
        self.historial.pop(real_idx)

        if self.eliminar_fn:
            self.eliminar_fn(h)

        self._poblar_tabla()

    def _sacar_etiquetas(self):
        idx = self._idx_sel()
        if idx is None:
            messagebox.showwarning("Sin selección",
                "Selecciona una lista del historial primero.", parent=self.win)
            return
        h = list(reversed(self.historial))[idx]
        self.win.destroy()
        self.etiquetas_fn(h)


