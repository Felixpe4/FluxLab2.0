    # ── BOT ETIQUETAS ─────────────────────────────────────────────────────────
    def _iniciar_etiquetas(self, hoja_historial: dict):
        hoja_historial = self._normalizar_historial_item(hoja_historial)
        self._encolar_etiquetas(hoja_historial)

    def _fecha_historial_item(self, item: dict) -> str:
        meta = item.get("_meta", {}) if isinstance(item.get("_meta"), dict) else {}
        ts = meta.get("timestamp_fin") or meta.get("timestamp") or ""
        return ts[:10] if len(ts) >= 10 else datetime.now().strftime("%Y-%m-%d")

    def _clave_etiquetas(self, hoja_historial: dict) -> str:
        grupo = mu_grupo_item(hoja_historial)
        if grupo:
            return f"{self._fecha_historial_item(hoja_historial)}|{grupo}"
        return str(hoja_historial.get("_historial_path") or hoja_historial.get("nombre", "?"))

    def _encolar_etiquetas(self, hoja_historial: dict):
        """
        Lanza el bot de etiquetas para esta lista/grupo, a pedido manual
        (boton "Sacar etiquetas"). Agrupa todas las hojas del mismo MU/OB/NOG/GYM
        (ver _items_historial_grupo / _preparar_grupo_etiquetas) en un solo PDF.
        Ya no se lanza automaticamente al terminar de ingresar una hoja —
        eso saturaba la PC con un segundo navegador en paralelo mientras el
        bot de ingreso seguia trabajando y la congelaba.
        """
        hoja_historial = self._normalizar_historial_item(hoja_historial)
        nombre = hoja_historial.get("nombre", "?")
        grupo = mu_grupo_item(hoja_historial)
        clave = self._clave_etiquetas(hoja_historial)

        with self.etiquetas_lock:
            activo = self.etiquetas_activos.get(clave)
            if activo is not None and activo.is_alive():
                self._log(f"  Bot etiquetas ya esta activo para: {grupo or nombre}")
                return
            t = threading.Thread(
                target=self._ejecutar_etiquetas, args=(hoja_historial, clave),
                daemon=True, name=f"bot-etiquetas-{clave}")
            self.etiquetas_activos[clave] = t

        self._log(f"\nBot de etiquetas lanzado: {grupo or nombre}")
        t.start()
        self._actualizar_lista()

    def _ejecutar_etiquetas(self, hoja_historial: dict, clave: str):
        try:
            self._bot_etiquetas(hoja_historial)
        finally:
            with self.etiquetas_lock:
                if self.etiquetas_activos.get(clave) is threading.current_thread():
                    self.etiquetas_activos.pop(clave, None)
            self._actualizar_lista()

    def _items_historial_grupo(self, item: dict) -> list[dict]:
        grupo = mu_grupo_item(item)
        if not grupo:
            return [item]
        fecha = self._fecha_historial_item(item)
        items = []
        for h in self._cargar_historial():
            if mu_grupo_item(h) == grupo and self._fecha_historial_item(h) == fecha:
                items.append(h)
        if not any(self._clave_etiquetas(h) == self._clave_etiquetas(item) and
                   h.get("_historial_path") == item.get("_historial_path") for h in items):
            items.append(item)
        items.sort(key=lambda h: (pagina_mu_item(h), h.get("nombre", "")))
        return items

    def _preparar_grupo_etiquetas(self, item: dict) -> dict:
        grupo_items = self._items_historial_grupo(item)
        if len(grupo_items) <= 1:
            return item

        pacientes = []
        for hoja in grupo_items:
            origen = hoja.get("nombre", "")
            origen_path = hoja.get("_historial_path", "")
            for pos, pac in enumerate(hoja.get("pacientes", []), 1):
                copia = pac.copy()
                copia["_origen_hoja"] = origen
                copia["_origen_historial_path"] = origen_path
                copia["_origen_posicion"] = pos
                pacientes.append(copia)

        grupo = mu_grupo_item(item) or item.get("nombre", "lista")
        combinado = item.copy()
        combinado["nombre"] = grupo
        combinado["pacientes"] = pacientes
        combinado["total"] = len(pacientes)
        combinado["_grupo_items"] = grupo_items
        combinado["_grupo_clave"] = grupo
        return combinado

