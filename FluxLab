def cargar_logo_ctk(size=40):
    """
    Carga logo PNG para CustomTkinter
    """
    ruta = ruta_recurso("logo_fluxlab.png")

    if not ruta.exists():
        return None

    img = Image.open(ruta).convert("RGBA")
    img = img.resize((size, size), Image.LANCZOS)

    return ctk.CTkImage(
        dark_image=img,
        light_image=img,
        size=(size, size)
    )
