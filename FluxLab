# Si la app está empaquetada (.exe), le pedimos a Playwright que busque el
# navegador dentro de su propio paquete (donde se incluye al compilar) en vez
# del caché global del usuario, para que el ejecutable quede autocontenido.
if getattr(sys, "frozen", False):
