# HELPERS GLOBALES v4.1 — Llenado de edad en formulario de nuevo paciente
# ══════════════════════════════════════════════════════════════════════════════
def _poner_edad(page, edad_val: str, tag: str, L, fecha_nac: str = ""):
    valor = edad_para_ingreso(edad_val, fecha_nac)
    L(f"{tag}  Edad a ingresar: '{valor}'")
    try:
        loc = page.locator("#edad").first
        if loc.count() and loc.is_visible(timeout=1500):
            loc.fill(""); page.wait_for_timeout(200)
            loc.type(valor, delay=60)
            return
    except Exception:
        pass
    try:
        for _ in range(5): page.keyboard.press("Tab")
        page.keyboard.type(valor)
    except Exception as e:
        L(f"{tag}  Advertencia poniendo edad (fallback): {e}")


def _poner_edad_seq(page, edad_val: str, L, fecha_nac: str = ""):
    valor = edad_para_ingreso(edad_val, fecha_nac)
    L(f"  Edad a ingresar: '{valor}'")
    try:
        loc = page.locator("#edad").first
        if loc.count() and loc.is_visible(timeout=1500):
            loc.fill(""); page.wait_for_timeout(200)
            loc.type(valor, delay=60)
            return
    except Exception:
        pass
    try:
        for _ in range(5): page.keyboard.press("Tab")
        page.keyboard.type(valor)
    except Exception as e:
        L(f"  Advertencia poniendo edad (fallback): {e}")


