# flecha hacia abajo en la lista de opciones antes de dar Enter — así siempre
# se selecciona la opción correcta sin depender de comparar el texto.
# Formato:  "NOMBRE DEL ESTUDIO": <veces que se presiona flecha abajo antes de Enter>
#   0 -> la primera opción de la lista (Enter directo)
#   1 -> la segunda opción (una flecha abajo + Enter), 2 -> la tercera, etc.
#
# Para agregar un caso nuevo: anota el orden exacto en que aparecen las
# opciones en el portal para ese estudio, y agrega una línea aquí.
SELECCION_MANUAL_ESTUDIOS = {
    "PROG": 2,
    "P4": 2,
    "PROGESTERONA": 2,   # opciones: 1) HIDROXIPROGESTERONA  2) PROGESTERONA <- esta
    "IMUNOGLOBULINA IGG": 2,
    "IGG": 2,
    "TG": 2,
    "TIROGLOBULINA": 2
}

def normalizar_estudio(est: str) -> str:
    e = est.strip().upper()
    if e in CATALOGO:
        return CATALOGO[e]
    for tir in TIROIDEOS_EXACTOS:
        if tir in e:
            return e
    for k, v in CATALOGO.items():
        if k in TIROIDEOS_EXACTOS:
            continue
        if e in k or k in e:
            return v
    return e

# ── v4.2: expandir_estudios — aplica EXPANSIONES sobre tokens crudos ──────────
# Importante: la expansion se hace ANTES de normalizar, porque normalizar
# colapsaria "BILI" -> "BILIRRUBINA DIRECTA" y perderiamos la posibilidad de
# saber que "BILI" significa AMBAS bilirrubinas.
def expandir_estudios(estudios: list) -> list:
    """
    Recorre los estudios crudos. Si el token esta en EXPANSIONES (en mayusculas
    y sin espacios extras), lo expande. Si no, lo deja igual para que el
    normalizador lo procese despues.
    Ej: ["BILI", "BHC"] -> ["BILIRRUBINA TOTAL", "BILIRRUBINA DIRECTA", "BHC"]
    """
    resultado = []
    for est in estudios:
        key = str(est).strip().upper()
        if key in EXPANSIONES:
            resultado.extend(EXPANSIONES[key])
        else:
            resultado.append(est)
    return resultado


def deduplicar_estudios(estudios: list) -> list:
    vistos, resultado = [], []
    for est in estudios:
        if est not in vistos:
            vistos.append(est)
            resultado.append(est)
    return resultado


# Pipeline unico: expande paquetes (BILI -> 2 bilis), normaliza el resto contra
# CATALOGO y deduplica. Usar este helper desde cualquier flujo que reciba la
# lista cruda de estudios (OCR, validacion manual, edicion individual).
def procesar_estudios(estudios_crudos: list) -> list:
    expandidos = expandir_estudios(estudios_crudos)
    normalizados = [normalizar_estudio(e) for e in expandidos]
    return deduplicar_estudios(normalizados)

def normalizar_numero(n: str) -> str:
    return str(n).replace("/", "").strip()

def edad_para_ingreso(edad_val: str, fecha_nac: str = "") -> str:
    if str(fecha_nac).strip():
        return "0"
    edad = str(edad_val).strip()
    return edad if edad.isdigit() else "0"


