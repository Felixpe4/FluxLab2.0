    def _editar_fila(self, event, idx_forzado=None, paciente_nuevo=False):
        if self.modo_seleccion:
            return
        if idx_forzado is None:
            sel = self.tabla.selection()
            if not sel: return
            idx = int(sel[0])
        else:
            idx = idx_forzado
        if not (0 <= idx < len(self.pacientes)):
            return
        pac = self.pacientes[idx]
        win = tk.Toplevel(self.win)
        win.title("Agregar paciente" if paciente_nuevo else "Editar paciente")
        win.geometry("440x620")
        win.configure(bg=COLORS["bg"]); win.grab_set(); win.resizable(False, False)
        ce = {}
        def fila(label, key, val):
            tk.Label(win, text=label, bg=COLORS["bg"], fg=COLORS["text_muted"],
                     font=("Courier", 8)).pack(anchor="w", padx=18, pady=(8,1))
            var = tk.StringVar(value=val)
            tk.Entry(win, textvariable=var, bg=COLORS["bg_surface"], fg=COLORS["text"],
                     insertbackground=COLORS["blue"], relief="flat",
                     font=("Courier", 10), width=42).pack(padx=18, ipady=4)
            ce[key] = var

        fila("Numero", "numero", pac.get("numero",""))
        fila("Nombre", "nombre", pac.get("nombre",""))
        fila("Estudios (separados por coma)", "estudios", ", ".join(pac.get("estudios",[])))

        # ── Campos Sexo, Edad y Fecha de nacimiento ──────────
        tk.Frame(win, bg=COLORS["border"], height=1).pack(fill="x", padx=18, pady=(12, 4))
        tk.Label(win, text="DATOS DEMOGRÁFICOS (se usan al crear paciente nuevo)",
                 bg=COLORS["bg"], fg=COLORS["blue"],
                 font=("Courier", 8, "bold")).pack(anchor="w", padx=18, pady=(0, 4))

        fila("Sexo  (M = Masculino  |  vacío = Femenino automático)", "sexo",
             pac.get("sexo", ""))
        fila("Edad  (número en años, ej: 45  |  0 si no se sabe)", "edad",
             pac.get("edad", ""))
        fila("Fecha nacimiento  (DD/MM/AAAA  |  vacío si no aplica)", "fecha_nacimiento",
             pac.get("fecha_nacimiento", ""))

        def guardar():
            nombre = ce["nombre"].get().strip().upper()
            if not nombre:
                messagebox.showwarning(
                    "Nombre requerido",
                    "Escribe el nombre del paciente antes de guardar.",
                    parent=win)
                return
            pac["numero"] = ce["numero"].get().strip()
            pac["nombre"] = nombre
            ests = [e.strip() for e in ce["estudios"].get().split(",") if e.strip()]
            pac["estudios"] = procesar_estudios(ests)
            sexo_raw = ce["sexo"].get().strip().upper()
            pac["sexo"] = "M" if sexo_raw in ("M", "MASCULINO", "HOMBRE", "H") else ""
            edad_raw = ce["edad"].get().strip()
            pac["edad"] = edad_raw if edad_raw.isdigit() else ""
            pac["fecha_nacimiento"] = ce["fecha_nacimiento"].get().strip()
            self._poblar_tabla()
            if paciente_nuevo:
                self.log_fn(f"  Paciente agregado manualmente: {pac['nombre']}")
            win.destroy()

        def cancelar():
            if paciente_nuevo and idx < len(self.pacientes) and self.pacientes[idx] is pac:
                self.pacientes.pop(idx)
                self._poblar_tabla()
            win.destroy()

        win.protocol("WM_DELETE_WINDOW", cancelar)

        tk.Button(win, text="Guardar", command=guardar,
                  bg=COLORS["blue"], fg="#000", relief="flat",
                  font=("Courier", 9, "bold"), cursor="hand2",
                  padx=16, pady=6).pack(side="left", padx=(105, 6), pady=14)
        tk.Button(win, text="Cancelar", command=cancelar,
                  bg=COLORS["bg_hover"], fg=COLORS["text_muted"], relief="flat",
                  font=("Courier", 9, "bold"), cursor="hand2",
                  padx=16, pady=6).pack(side="left", padx=(0, 6), pady=14)

    def _menu_contextual(self, event):
        sel = self.tabla.identify_row(event.y)
        if not sel: return
        self.tabla.selection_set(sel); idx = int(sel)
        menu = tk.Menu(self.win, tearoff=0, bg=COLORS["bg_surface"], fg=COLORS["text"],
                       activebackground=COLORS["blue_soft"],
                       activeforeground=COLORS["blue"], font=(FONT_UI, 9))
        menu.add_command(label="Editar",   command=lambda: self._editar_fila(None))
        menu.add_separator()
        menu.add_command(label="Eliminar", command=lambda: self._eliminar(idx))
        menu.tk_popup(event.x_root, event.y_root)

    def _eliminar(self, idx):
        nombre = self.pacientes[idx].get("nombre","?")
        if messagebox.askyesno("Eliminar", f"Eliminar a {nombre}?", parent=self.win):
            self.pacientes.pop(idx); self._poblar_tabla()

    def _guardar_en_cola(self):
        if not self.pacientes:
            messagebox.showwarning("Sin pacientes","No hay pacientes.",parent=self.win); return
        ingreso = {k: v.get().strip() for k, v in self.campos.items()}
        ts  = datetime.now().strftime("%Y%m%d_%H%M%S")
        out = DATA_DIR / f"validado_{ts}.json"
        payload = {
            "pacientes": self.pacientes, "total": len(self.pacientes),
            "ingreso": ingreso, "nombre": self.hoja["nombre"],
            "_meta": {"imagen": self.hoja["nombre"],
                      "timestamp": datetime.now().isoformat(), "estado": "validado"}
        }
        out.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        self.hoja["estado"]    = "validado"
        self.hoja["ingreso"]   = ingreso
        self.hoja["json_path"] = str(out)
        self.hoja["data"]["pacientes"] = self.pacientes
        self.hoja["data"]["total"] = len(self.pacientes)
        self.log_fn(f"\nLista guardada: {self.hoja['nombre']} — {len(self.pacientes)} pac.")
        self.log_fn(f"   Doctor: {ingreso['doctor']} | Empresa: {ingreso['empresa']}")
        self.log_fn(f"   -> Selecciona y presiona Iniciar bot\n")
        self.refresh_fn(); self.win.destroy()


