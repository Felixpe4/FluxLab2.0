def _extraer_texto_pdf(ruta: str) -> str:
    """Extrae texto de todas las páginas del PDF. Devuelve '' si no hay texto o falla."""
    try:
        import fitz
        doc  = fitz.open(ruta)
        texto = "\n".join(page.get_text() for page in doc)
        doc.close()
        return texto.strip()
    except Exception:
        return ""

def _detectar_rotacion(pix_low) -> int:
    """
    Analiza si el contenido de la imagen está girado 90°.
    Compara varianza de promedios por fila vs por columna.
    Si la varianza por columnas supera a la de filas, el contenido está landscape
    dentro de un frame portrait → retorna 90 (grados a rotar CW para corregir).
    """
    try:
        from PIL import Image
        W, H = pix_low.width, pix_low.height
        img = Image.frombytes("RGB", [W, H], pix_low.samples).convert("L")
        px  = list(img.getdata())
        row_means = [sum(px[r*W:(r+1)*W]) / W for r in range(H)]
        col_means = [sum(px[c::W]) / H           for c in range(W)]
        def var(lst):
            m = sum(lst)/len(lst)
            return sum((x-m)**2 for x in lst)/len(lst)
        return 90 if var(col_means) > var(row_means) * 1.3 else 0
    except Exception:
        return 0

def _pdf_a_imagenes(ruta: str) -> list:
    """Convierte cada página del PDF a bloque base64 PNG corregido de orientación."""
    try:
        import fitz
        from PIL import Image
        doc    = fitz.open(ruta)
        bloques = []
        for page in doc:
            pix_low = page.get_pixmap(dpi=40)
            rot     = _detectar_rotacion(pix_low)
            if rot:
                mat = fitz.Matrix(200/72, 200/72).prerotate(-rot)
            else:
                mat = fitz.Matrix(200/72, 200/72)
            pix = page.get_pixmap(matrix=mat)
            b64 = base64.standard_b64encode(pix.tobytes("png")).decode()
            bloques.append({"type":"image","source":{"type":"base64","media_type":"image/png","data":b64}})
        doc.close()
        return bloques
    except Exception:
        return []

def llamar_claude(prompt, ruta):
    if anthropic is None:
        raise RuntimeError("Falta instalar anthropic: pip install anthropic")
    api_key = obtener_api_key()
    if not api_key:
        raise RuntimeError("Falta ANTHROPIC_API_KEY o APIKEY.txt")
    try:
        api_key.encode("ascii")
    except UnicodeEncodeError as e:
        pos = e.start
        raise RuntimeError(
            f"La API key tiene un caracter invalido en posicion {pos} "
            f"(codigo U+{ord(api_key[pos]):04X}). "
            f"Copia la key directamente desde console.anthropic.com — no desde Word ni PDF."
        )
    client = anthropic.Anthropic(api_key=api_key)
    ext    = pathlib.Path(ruta).suffix.lower()

    if ext == ".pdf":
        texto = _extraer_texto_pdf(ruta)
        if len(texto) > 80:
            # PDF con capa de texto — mucho más confiable que visión
            content = [{"type": "text", "text": prompt + "\n\nTEXTO:\n" + texto}]
        else:
            # PDF solo imagen (escaneado sin OCR) — usar visión como respaldo
            bloques = _pdf_a_imagenes(ruta)
            if not bloques:
                with open(ruta,"rb") as f:
                    b64 = base64.standard_b64encode(f.read()).decode()
                bloques = [{"type":"document","source":{"type":"base64","media_type":"application/pdf","data":b64}}]
            content = bloques + [{"type":"text","text":prompt}]
    else:
        tipos = {".jpg":"image/jpeg",".jpeg":"image/jpeg",
                 ".png":"image/png",".webp":"image/webp",".jfif":"image/jpeg"}
        mt    = tipos.get(ext,"image/jpeg")
        with open(ruta,"rb") as f:
            b64 = base64.standard_b64encode(f.read()).decode()
        content = [
            {"type":"image","source":{"type":"base64","media_type":mt,"data":b64}},
            {"type":"text","text":prompt},
        ]

    msg = client.messages.create(
        model=ANTHROPIC_MODEL, max_tokens=16384,
        messages=[{"role":"user","content":content}],
    )
    raw = msg.content[0].text.strip()
    if "```" in raw:
        partes = raw.split("```")
        raw = partes[1] if len(partes) > 1 else raw
        raw = re.sub(r"^\s*json\s*", "", raw, flags=re.IGNORECASE).strip()
    return json.loads(raw)

def extraer_pacientes(ruta, log_fn):
    es_pdf = pathlib.Path(ruta).suffix.lower() == ".pdf"
    if es_pdf:
        texto = _extraer_texto_pdf(ruta)
        tiene_texto = len(texto) > 80
        log_fn(f"  PDF {'con texto' if tiene_texto else 'solo imagen (vision)'}")
        p_base     = PROMPT_BASE_PDF
        p_completo = PROMPT_COMPLETO_PDF
    else:
        p_base     = PROMPT_BASE
        p_completo = PROMPT_COMPLETO

    log_fn("  Pasada 1/2 — pacientes...")
    base = {"pacientes": []}
    for i in range(5):
        try:
            base = llamar_claude(p_base, ruta)
            if base.get("pacientes"): break
        except Exception as e:
            espera = 3 if "500" in str(e) or "server" in str(e).lower() else 1
            log_fn(f"  Intento {i+1}: {e}")
            if i < 4: time.sleep(espera * (i + 1))
    log_fn(f"  Pacientes encontrados: {len(base.get('pacientes', []))}")

    log_fn("  Pasada 2/2 — estudios...")
    completo = {"pacientes": []}
    for i in range(5):
        try:
            completo = llamar_claude(p_completo, ruta)
            if completo.get("pacientes"): break
        except Exception as e:
            espera = 3 if "500" in str(e) or "server" in str(e).lower() else 1
            log_fn(f"  Intento {i+1}: {e}")
            if i < 4: time.sleep(espera * (i + 1))

    dic = {normalizar_numero(p["numero"]): p for p in completo.get("pacientes", [])}
    total_estudios = sum(len(v.get("estudios", [])) for v in dic.values())
    log_fn(f"  Estudios detectados: {total_estudios} en {len(dic)} pacientes")
    resultado = []
    for p in base.get("pacientes", []):
        n   = normalizar_numero(p["numero"])
        pac = dic.get(n, {"numero": n, "nombre": p["nombre"], "estudios": []})
        pac["numero"]   = normalizar_numero(pac.get("numero",""))
        pac["estudios"] = procesar_estudios(pac.get("estudios", []))
        # ── NUEVO v4.1: preservar edad, fecha_nacimiento y sexo ──
        # Primero intentar desde completo (más detallado), fallback a base
        for campo in ("edad", "fecha_nacimiento", "sexo"):
            if not pac.get(campo):
                val_base = p.get(campo, "")
                if val_base:
                    pac[campo] = str(val_base).strip()
                else:
                    pac.setdefault(campo, "")
        # Normalizar sexo: si dice M, masculino, hombre → guardar "M"; de lo contrario ""
        sexo_raw = str(pac.get("sexo", "")).strip().upper()
        if sexo_raw in ("M", "MASCULINO", "HOMBRE", "MALE", "H"):
            pac["sexo"] = "M"
        else:
            pac["sexo"] = ""
        # Normalizar edad: asegurarse que sea string numérico o ""
        edad_raw = str(pac.get("edad", "")).strip()
        pac["edad"] = edad_raw if edad_raw.isdigit() else ""
        # Normalizar fecha_nacimiento: asegurarse de formato DD/MM/AAAA
        fn_raw = str(pac.get("fecha_nacimiento", "")).strip()
        pac["fecha_nacimiento"] = fn_raw
        resultado.append(pac)

    log_fn(f"  {len(resultado)} pacientes")
    return {"pacientes":resultado,"total":len(resultado)}


