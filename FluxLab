def ruta_recurso(nombre: str) -> pathlib.Path:
    """Busca un asset junto al ejecutable y, si no está, dentro del bundle de PyInstaller."""
    candidato = APP_DIR / nombre
    if candidato.exists():
        return candidato
    meipass = getattr(sys, "_MEIPASS", None)
    if meipass:
        return pathlib.Path(meipass) / nombre
    return candidato

