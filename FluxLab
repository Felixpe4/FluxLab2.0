    # ── NUEVO v4.2: Aplicar estudio(s) general(es) a todos los pacientes ──────
    def _aplicar_estudios_generales(self):
        raw = self.var_estudios_generales.get().strip()
        if not raw:
            messagebox.showwarning(
                "Sin estudios",
                "Escribe al menos un estudio en el campo antes de confirmar.",
                parent=self.win,
            )
            return
        # Soporta múltiples estudios separados por coma; expande paquetes (BILIS -> 2, etc.)
        nuevos = procesar_estudios([e.strip() for e in raw.split(",") if e.strip()])
        if not nuevos:
            return
        for pac in self.pacientes:
            ests = pac.get("estudios", [])
            for nuevo in nuevos:
                if nuevo not in ests:
                    ests.append(nuevo)
            pac["estudios"] = deduplicar_estudios(ests)
        self._poblar_tabla()
        self.var_estudios_generales.set("")
        self.log_fn(
            f"  Estudios generales agregados a {len(self.pacientes)} pacientes: "
            + ", ".join(nuevos)
        )

    # ── NUEVO v4.2: Eliminar todos los estudios OCR de todos los pacientes ────
    def _limpiar_todos_estudios(self):
        if not messagebox.askyesno(
            "Limpiar estudios",
            "¿Eliminar TODOS los estudios de TODOS los pacientes?\n\n"
            "Esto borrará los estudios detectados por el OCR.\n"
            "Puedes volver a agregarlos con el campo de arriba.",
            icon="warning",
            parent=self.win,
        ):
            return
        for pac in self.pacientes:
            pac["estudios"] = []
        self._poblar_tabla()
        self.log_fn("  Estudios eliminados de todos los pacientes.")

    def _ajustar_ancho_estudios(self):
        textos = ["Estudios"]
        for p in self.pacientes:
            textos.append(", ".join(p.get("estudios", [])))
        try:
            fuente = tkfont.nametofont("TkDefaultFont")
            ancho = max(fuente.measure(t) for t in textos) + 80
        except Exception:
            ancho = max(len(t) for t in textos) * 8 + 80
        ancho = max(self.anchos_tabla.get("Estudios", 1200), min(ancho, 2600))
        self.tabla.column("Estudios", width=ancho, minwidth=ancho, stretch=False)

    def _poblar_tabla(self):
        try:
            posicion_scroll = self.tabla.yview()[0]
        except Exception:
            posicion_scroll = 0.0
        self.tabla.delete(*self.tabla.get_children())
        self.pacientes_seleccionados = {
            idx for idx in self.pacientes_seleccionados
            if 0 <= idx < len(self.pacientes)
        }
        for i, p in enumerate(self.pacientes, 1):
            sexo_disp  = p.get("sexo", "")
            edad_disp  = p.get("edad", "")
            fn_disp    = p.get("fecha_nacimiento", "")
            seleccionado = (i - 1) in self.pacientes_seleccionados
            self.tabla.insert("", "end", iid=str(i-1),
                values=(("☑" if seleccionado else "☐") if self.modo_seleccion else "",
                        i,
                        p.get("numero",""),
                        p.get("nombre",""),
                        sexo_disp,
                        edad_disp,
                        fn_disp,
                        ", ".join(p.get("estudios",[]))),
                tags=("seleccionado_grupo",) if seleccionado else ())
        self._ajustar_ancho_estudios()
        self._actualizar_resumen()
        self._actualizar_estado_seleccion()
        self.tabla.yview_moveto(posicion_scroll)

    def _alternar_modo_seleccion(self):
        self.modo_seleccion = not self.modo_seleccion
        if not self.modo_seleccion:
            self.pacientes_seleccionados.clear()
        self._poblar_tabla()

    def _clic_seleccion_grupal(self, event):
        if not self.modo_seleccion:
            return None
        fila = self.tabla.identify_row(event.y)
        if not fila:
            return "break"
        idx = int(fila)
        if idx in self.pacientes_seleccionados:
            self.pacientes_seleccionados.remove(idx)
        else:
            self.pacientes_seleccionados.add(idx)
        self._poblar_tabla()
        return "break"

    def _actualizar_estado_seleccion(self):
        cantidad = len(self.pacientes_seleccionados)
        if self.modo_seleccion:
            self.btn_seleccionar.config(
                text="Cancelar selección", bg=COLORS["blue"], fg=COLORS["white"])
            self.lbl_seleccionados.config(
                text=f"{cantidad} seleccionado{'s' if cantidad != 1 else ''}")
            self.btn_borrar_pacientes.config(
                text=f"Borrar seleccionados ({cantidad})" if cantidad
                else "Borrar seleccionados")
        else:
            self.btn_seleccionar.config(
                text="Seleccionar", bg=COLORS["blue_soft"], fg=COLORS["blue"])
            self.lbl_seleccionados.config(text="")
            self.btn_borrar_pacientes.config(text="Borrar paciente")

    def _borrar_pacientes(self):
        if self.modo_seleccion:
            indices = sorted(self.pacientes_seleccionados)
            if not indices:
                messagebox.showwarning(
                    "Sin selección",
                    "Marca al menos un paciente para borrarlo.",
                    parent=self.win)
                return
            cantidad = len(indices)
            nombres = [self.pacientes[i].get("nombre", "?") for i in indices]
            muestra = "\n".join(f"• {nombre}" for nombre in nombres[:8])
            if cantidad > 8:
                muestra += f"\n• ... y {cantidad - 8} más"
            if not messagebox.askyesno(
                "Borrar pacientes en grupo",
                f"¿Eliminar {cantidad} paciente{'s' if cantidad != 1 else ''}?\n\n"
                f"{muestra}",
                icon="warning",
                parent=self.win,
            ):
                return
            for idx in reversed(indices):
                self.pacientes.pop(idx)
            self.log_fn(f"  {cantidad} pacientes eliminados en grupo.")
            self.pacientes_seleccionados.clear()
            self.modo_seleccion = False
            self._poblar_tabla()
            return

        seleccion = self.tabla.selection()
        if not seleccion:
            messagebox.showwarning(
                "Sin selección",
                "Selecciona un paciente de la tabla o activa el modo Seleccionar.",
                parent=self.win)
            return
        self._eliminar(int(seleccion[0]))

    def _agregar_paciente(self):
        if self.modo_seleccion:
            self.modo_seleccion = False
            self.pacientes_seleccionados.clear()

        paciente_nuevo = {
            "numero": "",
            "nombre": "",
            "estudios": [],
            "sexo": "",
            "edad": "",
            "fecha_nacimiento": "",
        }
        self.pacientes.append(paciente_nuevo)
        idx = len(self.pacientes) - 1
        self._poblar_tabla()
        self.tabla.selection_set(str(idx))
        self.tabla.focus(str(idx))
        self.tabla.see(str(idx))
        self._editar_fila(None, idx_forzado=idx, paciente_nuevo=True)

    def _armar_selector_doctor(self, entry, var, opciones):
        """Lista flotante propia: aparece al dar clic, filtra mientras se
        escribe SIN robarle el foco al campo (a diferencia del Combobox nativo
        de Tk, que abre su propio popup y corta la escritura)."""
        estado = {"win": None, "lista": None, "indice": -1}

        def cerrar(*_a):
            if estado["win"] is not None:
                estado["win"].destroy()
                estado["win"] = None
                estado["lista"] = None
                estado["indice"] = -1

        def elegir(texto_opcion):
            var.set(texto_opcion)
            cerrar()
            entry.icursor(tk.END)
            entry.focus_set()

        def resaltar(indice):
            lista = estado["lista"]
            if lista is None:
                return
            lista.selection_clear(0, tk.END)
            if 0 <= indice < lista.size():
                lista.selection_set(indice)
                lista.activate(indice)
                lista.see(indice)
            estado["indice"] = indice

        def refrescar(*_a):
            texto = var.get().strip().upper()
            filtradas = [op for op in opciones if texto in op.upper()] if texto else opciones
            if not filtradas:
                cerrar()
                return
            if estado["win"] is None:
                win = tk.Toplevel(self.win)
                win.overrideredirect(True)
                win.configure(bg=COLORS["border"])
                lista = tk.Listbox(win, bg=COLORS["bg_surface"], fg=COLORS["text"],
                                   selectbackground=COLORS["blue_soft"], selectforeground=COLORS["blue"],
                                   relief="flat", font=(FONT_UI, 10), highlightthickness=0,
                                   activestyle="none")
                lista.pack(fill="both", expand=True, padx=1, pady=1)
                lista.bind("<<ListboxSelect>>", lambda _e: (
                    elegir(lista.get(lista.curselection()[0])) if lista.curselection() else None))
                estado["win"] = win
                estado["lista"] = lista
            lista = estado["lista"]
            lista.delete(0, tk.END)
            for op in filtradas:
                lista.insert(tk.END, op)
            estado["indice"] = -1
            alto_filas = min(len(filtradas), 6)
            x = entry.winfo_rootx()
            y = entry.winfo_rooty() + entry.winfo_height()
            ancho = entry.winfo_width()
            estado["win"].geometry(f"{ancho}x{alto_filas * 22}+{x}+{y}")
            estado["win"].lift()

        def mover(delta):
            if estado["lista"] is None:
                refrescar()
            lista = estado["lista"]
            if lista is None or lista.size() == 0:
                return
            nuevo = max(0, min(lista.size() - 1, estado["indice"] + delta))
            resaltar(nuevo)

        def confirmar(_e=None):
            lista = estado["lista"]
            if lista is not None and 0 <= estado["indice"] < lista.size():
                elegir(lista.get(estado["indice"]))
                return "break"
            return None

        def tecla_arriba(_e):
            mover(-1)
            return "break"

        def tecla_abajo(_e):
            mover(1)
            return "break"

        entry.bind("<Button-1>", refrescar)
        entry.bind("<FocusIn>", refrescar)
        entry.bind("<KeyRelease>", lambda e: (
            None if e.keysym in ("Up", "Down", "Return", "Escape", "Tab") else refrescar()))
        entry.bind("<Down>", tecla_abajo)
        entry.bind("<Up>", tecla_arriba)
        entry.bind("<Return>", confirmar)
        entry.bind("<FocusOut>", lambda _e: entry.after(150, cerrar))
        entry.bind("<Escape>", lambda _e: cerrar())

