def logo_mark(parent, size=46, bg=None):
    """Logo FluxLab — canvas con las tres líneas."""
    bg = bg or COLORS["bg"]
    c  = tk.Canvas(parent, width=size, height=size, bg=bg,
                   highlightthickness=0, bd=0)
    s  = size / 46
    c.create_line(10*s, 10*s, 36*s, 10*s, width=int(9*s),
                  fill=COLORS["blue"], capstyle="round")
    c.create_line(10*s, 23*s, 30*s, 23*s, width=int(9*s),
                  fill=COLORS["blue"], capstyle="round")
    c.create_oval(6*s, 34*s, 16*s, 44*s,
                  fill=COLORS["blue"], outline="")
    return c

def styled_card(parent, bg=None, bd=1):
    """Frame con borde sutil — usado en ventanas legacy."""
    return tk.Frame(parent,
                    bg=bg or COLORS["bg_surface"],
                    bd=0, relief="flat",
                    highlightthickness=bd,
                    highlightbackground=COLORS["border"],
                    highlightcolor=COLORS["border"])

def style_treeview():
    """Estilo dark para ttk.Treeview — no se toca en Etapa 1."""
    style = ttk.Style()
    try:
        style.theme_use("clam")
    except tk.TclError:
        pass
    
    style.configure("Treeview",
        background=COLORS["bg_surface"],
        foreground=COLORS["text"],
        fieldbackground=COLORS["bg_surface"],
        rowheight=28,
        bordercolor=COLORS["border"],
        lightcolor=COLORS["border"],
        darkcolor=COLORS["border"],
        font=(FONT_UI, 9))
    style.configure("Treeview.Heading",
        background=COLORS["bg"],
        foreground=COLORS["text_muted"],
        font=(FONT_UI, 8, "bold"),
        relief="flat")
    style.map("Treeview",
        background=[("selected", COLORS["blue_soft"])],
        foreground=[("selected", COLORS["blue"])])
    style.configure("Vertical.TScrollbar",
        background=COLORS["bg_hover"],
        troughcolor=COLORS["bg_surface"],
        bordercolor=COLORS["border"],
        arrowcolor=COLORS["text_muted"])

def metric_card(parent, title, value, accent):
    """Tarjeta de métrica — usada dentro de ventanas legacy (tk puro)."""
    card = styled_card(parent)
    tk.Label(card, text=title,
             bg=COLORS["bg_surface"], fg=COLORS["text_muted"],
             font=(FONT_UI, 8)).pack(anchor="w", padx=14, pady=(10, 0))
    opts = {"textvariable": value} if hasattr(value, "get") else {"text": str(value)}
    tk.Label(card,
             bg=COLORS["bg_surface"], fg=COLORS["text"],
             font=(FONT_UI, 18, "bold"), **opts).pack(anchor="w", padx=14, pady=(0, 10))
    tk.Frame(card, bg=accent, height=3).pack(fill="x", side="bottom")
    return card


