            ctrl_web = leer_control_interno(page)
            L(f"    Control interno web : '{ctrl_web}'")
            L(f"    Control interno esp : '{num_a_ctrl(numero_pac)}' (num: {numero_pac})")

            if numero_pac and not ctrl_coincide(numero_pac, ctrl_web):
