            obs_web = leer_observacion(page)
            L(f"    Observacion web : '{obs_web}'")
            L(f"    Observacion lista: '{obs_lista}'")

            mu_web   = extraer_mu(obs_web)
            mu_lista = mu_esperado or extraer_mu(obs_lista)
            L(f"    MU/OB/NOG/GYM web: '{mu_web}'  |  MU/OB/NOG/GYM lista: '{mu_lista}'")

            if mu_lista and not mu_web:
                L(f"    [x] No pude confirmar MU/OB/NOG/GYM en la solicitud web -> descarto este candidato")
                return False

            if not observacion_coincide(obs_lista, obs_web, mu_lista):
                L(f"    [x] Observacion/MU-OB-NOG-GYM NO coincide -> descarto este candidato")
                return False

            L(f"    [OK] Verificacion OK (nombre + control + MU/OB/NOG/GYM/obs) -> marcando")
            try:
                cb = fila.locator("input.checkbox_lotes_edt, input[type='checkbox']").first
                if not cb.count():
                    L("    La fila no tiene checkbox"); return False
                if not cb.is_checked(timeout=1000):
                    cb.check(force=True, timeout=3000)
                    time.sleep(0.4)
                L(f"    [OK] Marcado: {cand['nombre']}"); return True
            except Exception as e:
                L(f"    Error marcando checkbox: {e}"); return False

        class ErrorEtiquetasPDF(RuntimeError):
            pass

        pdfs_registrados = []

        def guardar_pdf(page, item: dict, pdf_path: pathlib.Path):
            boton = primer_visible(page, [
                "button.btn-etiquetas", "button:has-text('Etiquetas')",
                "a:has-text('Etiquetas')", "input[value*='Etiquetas']"], timeout=2500)
            if not boton: raise RuntimeError("No encontre el boton Etiquetas")

            def registrar():
                fecha = datetime.now().isoformat()
                ruta_pdf = str(pdf_path)
                if ruta_pdf not in pdfs_registrados:
                    pdfs_registrados.append(ruta_pdf)

                def aplicar(registro: dict):
                    registro["etiqueta_pdf"] = pdfs_registrados[0]
                    registro["etiqueta_pdfs"] = list(pdfs_registrados)
                    registro["etiqueta_fecha"] = fecha

                grupo_items = item.get("_grupo_items") or []
                if grupo_items:
                    for hoja in grupo_items:
                        aplicar(hoja)
                        hoja["etiqueta_grupo"] = item.get("_grupo_clave", item.get("nombre", ""))
                        self._guardar_historial_item(hoja)
                else:
                    aplicar(item)
                    self._guardar_historial_item(item)

            def escribir_pdf(data: bytes) -> bool:
                if not data or len(data) < 100: return False
                if not data.lstrip().startswith(b"%PDF"): return False
                pdf_path.write_bytes(data); registrar(); return True

            def descargar_url(context, url: str) -> bool:
                if not url or url.startswith(("about:", "chrome:", "devtools:")): return False
                if url.startswith("blob:"): return False
                try:
                    resp = context.request.get(url, timeout=30000)
                    if resp.status >= 400: return False
                    return escribir_pdf(resp.body())
                except Exception: return False

            def pagina_tiene_pdf(pdf_page) -> bool:
                if pdf_page.is_closed(): return False
                try:
                    return bool(pdf_page.evaluate("""
                        () => !!document.querySelector(
                            'embed[type*="pdf"], object[type*="pdf"], iframe[src*=".pdf"], iframe[src^="blob:"]'
                        )
                    """))
                except Exception:
                    return False

            def pagina_tiene_error(pdf_page) -> bool:
                if pdf_page.is_closed(): return False
                try:
                    info = pdf_page.evaluate("""
                        () => {
                            const body = (document.body && document.body.innerText) || '';
                            const title = document.title || '';
                            const href = location.href || '';
                            const tienePdf = !!document.querySelector(
                                'embed[type*="pdf"], object[type*="pdf"], iframe[src*=".pdf"], iframe[src^="blob:"]'
                            );
                            return { body, title, href, tienePdf };
                        }
                    """)
                except Exception:
                    return False
                if info.get("tienePdf"):
                    return False
                texto = texto_plano(" ".join([info.get("title", ""), info.get("href", ""), info.get("body", "")]))
                claves_error = [
                    "HTTP ERROR", "FATAL ERROR", "ERROR 404", "ERROR 500",
                    "500 INTERNAL", "503 SERVICE", "SERVER ERROR", "NOT FOUND",
                    "EXCEPTION", "STACK TRACE", "PAGINA NO FUNCIONA",
                    "NO SE PUEDE PROCESAR", "NO PUEDE PROCESAR"
                ]
                return any(clave in texto for clave in claves_error)

            def guardar_desde_pagina(pdf_page, detectar_error=True) -> bool:
                if pdf_page.is_closed(): return False
                try:
                    urls = pdf_page.evaluate("""
                        () => {
                            const out = [location.href];
                            for (const el of document.querySelectorAll('embed, iframe, object, a')) {
                                out.push(el.src || el.data || el.href || '');
                            }
                            return [...new Set(out.filter(Boolean))];
                        }
                    """)
                except Exception: urls = []
                for url in urls:
                    if url.startswith("blob:"):
                        try:
                            b64 = pdf_page.evaluate("""
                                async (url) => {
                                    const resp = await fetch(url);
                                    const buf = await resp.arrayBuffer();
                                    const bytes = new Uint8Array(buf);
                                    let binary = '';
                                    const chunk = 0x8000;
                                    for (let i = 0; i < bytes.length; i += chunk) {
                                        binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
                                    }
                                    return btoa(binary);
                                }
                            """, url)
                            if escribir_pdf(base64.b64decode(b64)): return True
                        except Exception: continue
                    elif descargar_url(pdf_page.context, url): return True
                if detectar_error and pagina_tiene_error(pdf_page):
                    raise ErrorEtiquetasPDF("El sistema mostro una pagina de error al generar etiquetas")
                return False

            context = page.context
            downloads = []
            paginas_antes = set(context.pages)
            url_antes = page.url

            def on_download(download):
                downloads.append(download)

            page.on("download", on_download)
            try:
                boton.click(timeout=5000)
                deadline = time.time() + 45
                while time.time() < deadline:
                    if downloads:
                        downloads[0].save_as(str(pdf_path))
                        try:
                            if pdf_path.read_bytes()[:512].lstrip().startswith(b"%PDF"):
                                registrar(); return
                        except Exception:
                            pass
                        try:
                            pdf_path.unlink(missing_ok=True)
                        except Exception:
                            pass
                        raise ErrorEtiquetasPDF("La descarga de etiquetas no fue un PDF valido")

                    paginas_nuevas = [p for p in context.pages if p not in paginas_antes]
                    for popup in paginas_nuevas:
                        try: popup.wait_for_load_state("domcontentloaded", timeout=1000)
                        except Exception: pass
                        if guardar_desde_pagina(popup, detectar_error=True): return

                    if not page.is_closed() and (page.url != url_antes or pagina_tiene_pdf(page)):
                        if guardar_desde_pagina(page, detectar_error=True): return
                    time.sleep(0.5)

                paginas_nuevas = [p for p in context.pages if p not in paginas_antes]
                if any(pagina_tiene_error(p) for p in paginas_nuevas):
                    raise ErrorEtiquetasPDF("El sistema mostro una pagina de error al generar etiquetas")
                raise RuntimeError("Se genero el PDF, pero no pude capturar archivo/URL para guardarlo")
            finally:
                try:
                    page.remove_listener("download", on_download)
                except Exception:
                    pass

        try:
            h = self._normalizar_historial_item(h)
            h = self._preparar_grupo_etiquetas(h)
            pacientes_lista = h.get("pacientes", [])
            ingreso         = h.get("ingreso", {})
            nombre_lista    = h.get("nombre", "lista")
            obs_lista       = str(ingreso.get("observacion", "")).strip().upper()
            mu_esperado     = mu_desde_historial(h)
            doctor_texto    = str(ingreso.get("doctor", "")).strip()
            fecha_ingreso   = fecha_historial(h)
            grupo_items     = h.get("_grupo_items") or []
            try:
                limite_pacientes_pdf = int(os.getenv("ETIQUETAS_MAX_PACIENTES_PDF", "100"))
            except ValueError:
                limite_pacientes_pdf = 100
            limite_pacientes_pdf = max(1, limite_pacientes_pdf)
            minimo_pacientes_split = 25

            L(f"\n{'='*50}")
            L(f"  BOT ETIQUETAS: {nombre_lista}")
            L(f"  Fecha filtro: {fecha_ingreso}")
            L(f"  Doctor: {doctor_texto or '(sin filtro)'}")
            L(f"  Observacion lista: {obs_lista or '(vacia)'}")
            L(f"  MU/OB/NOG/GYM esperado desde historial: {mu_esperado or '(ninguno)'}")
            if grupo_items:
                L(f"  Hojas agrupadas: {len(grupo_items)}")
            L(f"  Pacientes a marcar: {len(pacientes_lista)}")
            L(f"  Limite por PDF: {limite_pacientes_pdf} pacientes")
            L(f"  VERIFICACION ACTIVA: nombre + control interno + MU/OB/NOG/GYM/observacion")
            L(f"{'='*50}")

            if not LAB_USER or not LAB_PASS:
                L("  ERROR: faltan LAB_BOT_USER o LAB_BOT_PASS"); return
            if not pacientes_lista:
                L("  ERROR: la lista no tiene pacientes"); return
            if not mu_esperado:
                L("  ADVERTENCIA: no encontre MU/OB/NOG/GYM en historial; usare observacion completa como respaldo")

            ts_now = datetime.now().strftime("%Y%m%d_%H%M%S")
            pdf_base = f"etiquetas_{nombre_archivo_seguro(nombre_lista)}_{ts_now}"
            pdfs_abiertos = set()

            def abrir_pdf_guardado(pdf_path: pathlib.Path):
                ruta = str(pdf_path)
                if ruta in pdfs_abiertos:
                    return
                try:
                    import subprocess, sys
                    if sys.platform == "win32":
                        os.startfile(ruta)
                    elif sys.platform == "darwin":
                        subprocess.run(["open", ruta])
                    else:
                        subprocess.run(["xdg-open", ruta])
                    pdfs_abiertos.add(ruta)
                    L(f"  PDF abierto: {pdf_path.name}")
                except Exception as e:
                    L(f"  PDF guardado, pero no se pudo abrir: {e}")

            with sync_playwright() as pw:
                browser = pw.chromium.launch(headless=False)
                context = browser.new_context(accept_downloads=True)
                page    = context.new_page()
                L("Login...")
                page.goto(f"{LAB_BASE_URL}/nuevo", timeout=60000, wait_until="load")
                try:
                    page.wait_for_selector("#ingUsuario", state="visible", timeout=10000)
                    page.fill("#ingUsuario", LAB_USER)
                    page.fill('input[name="ingPassword"]', LAB_PASS)
                    page.click('button:has-text("Ingresar")')
                    time.sleep(4)
                except PWT:
                    L("  No vi formulario de login; continuo con la sesion actual")
                L("  Login OK")

                L("Cargando filtro de solicitudes...")
                page.goto(url_editar(fecha_ingreso), timeout=60000, wait_until="load")
                time.sleep(2.0)
                doctor_value = obtener_doctor_value(page, doctor_texto)
                if doctor_value: L(f"  Doctor value: {doctor_value}")
                elif doctor_texto: L("  No encontre value del doctor; usare solo fecha")

                page.goto(url_editar(fecha_ingreso, doctor_value), timeout=60000, wait_until="load")
                time.sleep(2.0); click_buscar(page)
                if not esperar_tabla(page):
                    L("  ERROR: no cargo la tabla #TablaPacientes"); return
                L("  Tabla cargada")

                def clave_fila_marcada(cand: dict) -> str:
                    folioid = str(cand.get("folioid", "")).strip()
                    if folioid:
                        return f"folioid:{folioid}"
                    folio = str(cand.get("folio", "")).strip()
                    if folio:
                        return f"folio:{folio}"
                    pagina = cand.get("_pagina", "")
                    indice = cand.get("index", "")
                    nombre = texto_plano(cand.get("nombre", ""))
                    return f"fila:{pagina}:{indice}:{nombre}"

                def cerrar_paginas_extra():
                    for extra in list(context.pages):
                        try:
                            if extra is not page and not extra.is_closed():
                                extra.close()
                        except Exception:
                            pass

                def asegurar_sesion_en_pagina():
                    page.goto(f"{LAB_BASE_URL}/nuevo", timeout=60000, wait_until="load")
                    try:
                        page.wait_for_selector("#ingUsuario", state="visible", timeout=3000)
                        page.fill("#ingUsuario", LAB_USER)
                        page.fill('input[name="ingPassword"]', LAB_PASS)
                        page.click('button:has-text("Ingresar")')
                        time.sleep(4)
                        L("  Login renovado")
                    except PWT:
                        pass

                def cargar_tabla_filtrada():
                    nonlocal page

                    def intentar_cargar() -> bool:
                        page.goto(url_editar(fecha_ingreso, doctor_value), timeout=60000, wait_until="load")
                        time.sleep(2.0); click_buscar(page)
                        return esperar_tabla(page)

                    if intentar_cargar():
                        return

                    L("  La pagina de solicitudes no se recupero; abro una pestaña limpia")
                    cerrar_paginas_extra()
                    try:
                        if not page.is_closed():
                            page.close()
                    except Exception:
                        pass
                    page = context.new_page()
                    asegurar_sesion_en_pagina()

                    if intentar_cargar():
                        return

                    raise RuntimeError("no cargo la tabla #TablaPacientes")

                def nombre_pac(pac: dict) -> str:
                    return str(pac.get("nombre", "")).strip() or "(sin nombre)"

                def pdf_path_rango(inicio_abs: int, fin_abs: int) -> pathlib.Path:
                    if inicio_abs == 0 and fin_abs == len(pacientes_lista):
                        return ETIQUETAS_DIR / f"{pdf_base}.pdf"
                    return ETIQUETAS_DIR / f"{pdf_base}_parte_{inicio_abs + 1:03d}-{fin_abs:03d}.pdf"

                def marcar_pacientes(pacientes_rango: list, inicio_abs: int) -> tuple[int, list[str]]:
                    fin_abs = inicio_abs + len(pacientes_rango)
                    L(f"\nMarcando etiquetas {inicio_abs + 1}-{fin_abs} de {len(pacientes_lista)}")
                    cargar_tabla_filtrada()
                    marcados = 0
                    no_marcados = []
                    filas_marcadas = set()

                    for offset, pac in enumerate(pacientes_rango, 1):
                        posicion_abs = inicio_abs + offset
                        nombre_pac_actual = nombre_pac(pac)
                        numero_pac = pac.get("numero", "").strip()
                        origen = pac.get("_origen_hoja", "")
                        origen_txt = f"  |  hoja: {origen}" if origen else ""
                        L(f"\n  [{posicion_abs}/{len(pacientes_lista)}] Buscando: {nombre_pac_actual}  |  numero: {numero_pac}{origen_txt}")
                        L(f"  Control interno esperado: {num_a_ctrl(numero_pac)}")
                        encontrado = False; pagina = 1
                        ir_a_primera_pagina(page)
                        while True:
                            filas_data = leer_tabla(page)
                            candidatos = [fila for fila in filas_data if nombres_coinciden(nombre_pac_actual, fila["nombre"])]
                            L(f"    Pagina {pagina}: {len(filas_data)} filas, {len(candidatos)} candidatos por nombre")
                            for cand in candidatos:
                                cand["_pagina"] = pagina
                                clave_cand = clave_fila_marcada(cand)
                                if clave_cand in filas_marcadas:
                                    L(f"      Candidato ya usado en esta parte: {cand.get('nombre', '')} (folio={cand.get('folio', '')})")
                                    continue
                                L(f"      Candidato: {cand.get('nombre', '')} (folio={cand.get('folio', '')})")
                                if abrir_fila_y_marcar(page, cand, pac, obs_lista, mu_esperado):
                                    filas_marcadas.add(clave_cand)
                                    marcados += 1; encontrado = True; break
                            if encontrado: break
                            if not siguiente_pagina(page): break
                            pagina += 1
                        if not encontrado:
                            L(f"  [!] No se pudo marcar con triple verificacion: {nombre_pac_actual}")
                            no_marcados.append(nombre_pac_actual)

                    L(f"\n  Resumen parte {inicio_abs + 1}-{fin_abs}: {marcados} marcados, {len(no_marcados)} sin marcar")
                    if no_marcados: L(f"  Sin marcar en esta parte: {', '.join(no_marcados)}")
                    return marcados, no_marcados

                def generar_rango(pacientes_rango: list, inicio_abs: int) -> list[pathlib.Path]:
                    if not pacientes_rango:
                        return []
                    fin_abs = inicio_abs + len(pacientes_rango)
                    marcados, _ = marcar_pacientes(pacientes_rango, inicio_abs)
                    if marcados == 0:
                        L(f"  No se marco ningun paciente en {inicio_abs + 1}-{fin_abs}; no genero PDF")
                        return []

                    pdf_path = pdf_path_rango(inicio_abs, fin_abs)
                    L(f"\nGenerando PDF de etiquetas {inicio_abs + 1}-{fin_abs}...")
                    try:
                        guardar_pdf(page, h, pdf_path)
                        L(f"  PDF guardado: {pdf_path.name}")
                        abrir_pdf_guardado(pdf_path)
                        return [pdf_path]
                    except Exception as e:
                        cerrar_paginas_extra()
                        if len(pacientes_rango) <= minimo_pacientes_split:
                            L(f"  [!] No pude generar PDF para {inicio_abs + 1}-{fin_abs}: {e}")
                            return []

                        mitad_rel = len(pacientes_rango) // 2
                        mitad_abs = inicio_abs + mitad_rel
                        ultimo_primera = nombre_pac(pacientes_rango[mitad_rel - 1])
                        primero_segunda = nombre_pac(pacientes_rango[mitad_rel])
                        L(f"  El sistema devolvio error al generar {inicio_abs + 1}-{fin_abs}: {e}")
                        L("  Divido este bloque en dos partes para no perder pacientes.")
                        L(f"  Primera mitad termina en #{mitad_abs}: {ultimo_primera}")
                        L(f"  Segunda mitad inicia en #{mitad_abs + 1}: {primero_segunda}")

                        pdfs = []
                        pdfs.extend(generar_rango(pacientes_rango[:mitad_rel], inicio_abs))
                        pdfs.extend(generar_rango(pacientes_rango[mitad_rel:], mitad_abs))
                        return pdfs

                def generar_por_bloques() -> list[pathlib.Path]:
                    total = len(pacientes_lista)
                    if total <= limite_pacientes_pdf:
                        return generar_rango(pacientes_lista, 0)

                    total_bloques = (total + limite_pacientes_pdf - 1) // limite_pacientes_pdf
                    L(f"\nTotal combinado: {total} pacientes")
                    L(f"Se generaran etiquetas en {total_bloques} PDFs de maximo {limite_pacientes_pdf} pacientes")

                    pdfs = []
                    for num_bloque, inicio_abs in enumerate(range(0, total, limite_pacientes_pdf), 1):
                        fin_abs = min(inicio_abs + limite_pacientes_pdf, total)
                        primero = nombre_pac(pacientes_lista[inicio_abs])
                        ultimo = nombre_pac(pacientes_lista[fin_abs - 1])
                        L(f"\nBloque {num_bloque}/{total_bloques}: pacientes {inicio_abs + 1}-{fin_abs}")
                        L(f"  Inicia con: {primero}")
                        L(f"  Termina con: {ultimo}")
                        pdfs.extend(generar_rango(pacientes_lista[inicio_abs:fin_abs], inicio_abs))
                    return pdfs

                pdfs_generados = generar_por_bloques()
                if not pdfs_generados:
                    L("  No se genero ningun PDF de etiquetas"); return

                if len(pdfs_generados) > 1:
                    L(f"\n  PDFs guardados en {len(pdfs_generados)} partes")
                else:
                    L(f"\n  PDF guardado: {pdfs_generados[0].name}")

                L("  Verificando PDFs abiertos...")
                for pdf_path in pdfs_generados:
                    abrir_pdf_guardado(pdf_path)

        except PWT as e:
            L(f"  Timeout en bot de etiquetas: {e}")
        except Exception as e:
            L(f"  Error en bot de etiquetas: {e}")
        finally:
            try:
                if browser and browser.is_connected(): browser.close()
            except Exception: pass
            L(f"\nBot de etiquetas terminado: {h.get('nombre', 'lista')}\n")

    def run(self):
        self.root.mainloop()


