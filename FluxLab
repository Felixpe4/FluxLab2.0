def _area_trabajo_windows():
    """
    Consulta a Windows el área de trabajo real (pantalla completa MENOS
    la barra de tareas, sin importar en qué borde esté ni su tamaño).
    Devuelve (x, y, ancho, alto) o None si no aplica/falla (p.ej. en
    otros sistemas operativos).
    """
    if sys.platform != "win32":
        return None
    try:
        import ctypes
        from ctypes import wintypes
        SPI_GETWORKAREA = 0x0030
        rect = wintypes.RECT()
        if ctypes.windll.user32.SystemParametersInfoW(SPI_GETWORKAREA, 0, ctypes.byref(rect), 0):
            return (rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top)
    except Exception:
        pass
    return None

def maximizar_ventana(root):
    """
    Maximiza una ventana (tk.Tk, tk.Toplevel o CTk) ocupando todo el área
    de trabajo mientras conserva la barra de título (minimizar/restaurar/
    cerrar) y deja visible la barra de tareas — "ventana completa", no
    "pantalla completa" sin bordes.

    En Windows se consulta el área de trabajo real vía API (más confiable
    que 'zoomed', que en algunos equipos reporta éxito sin respetar la
    barra de tareas) y se ajusta la geometría exactamente a ese rectángulo.
    En otros sistemas, o si la consulta falla, se recurre a 'zoomed' y
    -fullscreen como respaldo.
    """
    root.update_idletasks()
    area = _area_trabajo_windows()
    if area:
        x, y, ancho, alto = area
        root.geometry(f"{ancho}x{alto}+{x}+{y}")
        root.update_idletasks()
        return

    ancho, alto = root.winfo_screenwidth(), root.winfo_screenheight()
    try:
        root.state("zoomed")
        root.update()
        if root.winfo_width()  >= ancho * 0.9 and \
           root.winfo_height() >= alto  * 0.9:
            return
    except Exception:
        pass
    try:
        root.attributes("-fullscreen", True)
        root.update()
        if root.winfo_width()  >= ancho * 0.9 and \
           root.winfo_height() >= alto  * 0.9:
            return
    except Exception:
        pass
    root.geometry(f"{ancho}x{alto}+0+0")

def manejar_apertura_caja(page, log_fn=None, tag=""):
    """
    La primera vez que se entra a 'Nuevo Paciente' en el día, el portal
    muestra la interfaz de apertura de caja (botón #btnModalApertura).
    Si aparece, la apertura y vuelve a entrar a 'Nuevo Paciente'; si no
    aparece (porque ya se aperturó antes, quizás por otra persona), no
    hace nada y el flujo normal de ingreso continúa sin interrupción.
    """
    L = log_fn or (lambda *_a, **_k: None)
    try:
        visible = page.locator("#btnModalApertura").is_visible(timeout=2500)
    except Exception:
        visible = False
    if not visible:
        return
    L(f"{tag}Apertura de caja detectada — aperturando...")
    try:
        page.locator("#btnModalApertura").click(timeout=3000)
        time.sleep(1.5)
        page.locator("i.fa-file").first.click(force=True)
        time.sleep(2)
        L(f"{tag}Caja aperturada; continúo con ingreso normal")
    except Exception as e:
        L(f"{tag}No pude completar la apertura de caja: {e}")

