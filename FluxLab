def asegurar_chromium() -> bool:
    """
    Verifica que Playwright tenga Chromium disponible. Si corre como script
    (no empaquetada) y falta, lo descarga automáticamente — solo ocurre una
    vez por instalación. En el .exe el navegador ya viene incluido al compilar.
    """
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        return False

    try:
        with sync_playwright() as pw:
            navegador = pw.chromium.launch(headless=True)
            navegador.close()
        return True
    except Exception:
        pass

    if getattr(sys, "frozen", False):
        return False

    try:
        import subprocess
        resultado = subprocess.run(
            [sys.executable, "-m", "playwright", "install", "chromium"],
            capture_output=True, text=True,
        )
        return resultado.returncode == 0
    except Exception:
        return False

def nombre_archivo_seguro(nombre: str) -> str:
    limpio = re.sub(r'[<>:"/\\|?*\x00-\x1f]+', "_", str(nombre)).strip()
    limpio = re.sub(r"\s+", " ", limpio)
    return limpio[:120] or "lista"

def texto_plano(texto: str) -> str:
    normal = unicodedata.normalize("NFKD", str(texto).upper())
    normal = "".join(c for c in normal if not unicodedata.combining(c))
    normal = re.sub(r"[^A-Z0-9]+", " ", normal)
    return re.sub(r"\s+", " ", normal).strip()

CLAVE_ETIQUETA_RE = re.compile(r"\b(MU|OB|NOG|GYM|AP)[\s\-]*(\d+)\b", re.IGNORECASE)

def extraer_mu(texto: str) -> str:
    m = CLAVE_ETIQUETA_RE.search(str(texto))
    return f"{m.group(1).upper()}-{m.group(2)}" if m else ""

def _partes_mu(texto: str) -> tuple[str, str]:
    m = CLAVE_ETIQUETA_RE.search(str(texto))
    if not m:
        return "", ""
    numero = m.group(2).lstrip("0") or "0"
    return m.group(1).upper(), numero

def _numero_mu(texto: str) -> str:
    return _partes_mu(texto)[1]

def mu_coincide(mu_a: str, mu_b: str) -> bool:
    pref_a, num_a = _partes_mu(mu_a)
    pref_b, num_b = _partes_mu(mu_b)
    return bool(pref_a and pref_b and num_a and num_b and pref_a == pref_b and num_a == num_b)

def fuentes_mu_item(item: dict) -> list[str]:
    if not isinstance(item, dict):
        return [str(item)]
    ingreso = item.get("ingreso") if isinstance(item.get("ingreso"), dict) else {}
    meta = item.get("_meta") if isinstance(item.get("_meta"), dict) else {}
    return [
        item.get("nombre", ""),
        meta.get("imagen", ""),
        item.get("_historial_path", ""),
        ingreso.get("observacion", ""),
        item.get("observacion", ""),
    ]

def mu_grupo_item(item: dict) -> str:
    for fuente in fuentes_mu_item(item):
        mu = extraer_mu(fuente)
        if mu:
            return mu
    return ""

def pagina_mu_item(item: dict) -> int:
    for fuente in fuentes_mu_item(item)[:3]:
        try:
            texto = Path(str(fuente)).stem.upper()
        except Exception:
            texto = str(fuente).upper()
        m = re.search(r"\b(?:MU|OB|NOG|GYM|AP)[\s\-]*\d+\s+(\d{1,3})(?=\D|$)", texto)
        if m:
            try:
                return int(m.group(1))
            except ValueError:
                pass
    return 1

