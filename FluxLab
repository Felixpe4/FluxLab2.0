class MainApp:
    def __init__(self, usuario: str):
        self._main_thread = threading.current_thread()
        self.usuario     = usuario
        self.cola        = []
        self.historial   = self._cargar_historial()
        self.detener_bot = False

        # Paralelo: bots ingreso
        self.bots_activos: dict[str, threading.Thread] = {}
        self.bots_lock    = threading.Lock()
        self.detener_bots: set[str] = set()

        # Paralelo: bots etiquetas
        self.etiquetas_activos: dict[str, threading.Thread] = {}
        self.etiquetas_lock = threading.Lock()

        # Legacy
        self.bot_activo       = False

        self._drag_idx = None

        if CTK_AVAILABLE:
            self._build_ctk()
        else:
            self._build_tk_legacy()

        # Reviso actualizaciones en segundo plano, sin bloquear el arranque ni
        # interrumpir el login — si hay una versión nueva, se ofrece sola.
        self.root.after(2500, lambda: threading.Thread(
            target=self._revisar_actualizaciones, daemon=True).start())

    # ─────────────────────────────────────────────────────────────────────────
    # AUTO-ACTUALIZACIÓN
    # ─────────────────────────────────────────────────────────────────────────
    def _revisar_actualizaciones(self):
        if not getattr(sys, "frozen", False):
            return
        actualizacion = buscar_actualizacion()
        if not actualizacion:
            return
        version_nueva, url_descarga, tamano_esperado = actualizacion
        self._en_ui(self._ofrecer_actualizacion, version_nueva, url_descarga, tamano_esperado)

    def _ofrecer_actualizacion(self, version_nueva: str, url_descarga: str, tamano_esperado: int = 0):
        if not messagebox.askyesno(
            "Actualización disponible",
            f"Hay una nueva versión de {APP_NAME} disponible: {version_nueva}\n"
            f"(tienes la {APP_VERSION}).\n\n"
            "¿Quieres descargarla e instalarla ahora?\n"
            "La app se cerrará y se volverá a abrir sola, ya actualizada.",
            parent=self.root,
        ):
            return
        self._log(f"\nDescargando actualización {version_nueva}...")
        threading.Thread(
            target=self._descargar_e_instalar_actualizacion,
            args=(version_nueva, url_descarga, tamano_esperado), daemon=True).start()

    def _descargar_e_instalar_actualizacion(self, version_nueva: str, url_descarga: str, tamano_esperado: int = 0):
        self._log("  (La app sigue funcionando con normalidad durante la descarga)")
        ok = preparar_actualizacion(
            url_descarga, version_nueva,
            tamano_esperado=tamano_esperado, log_fn=self._log)
        if ok:
            self._log("Actualización lista — la app se cerrará y se reabrirá sola ya actualizada.")
            self._en_ui(self._reiniciar_para_actualizar)
        else:
            self._en_ui(lambda: messagebox.showwarning(
                "Actualización fallida",
                f"No se pudo instalar la versión {version_nueva}.\n\n"
                "Revisa el log para ver el detalle del error.\n"
                "Se seguirá usando la versión actual sin interrupción.",
                parent=self.root))

    def _reiniciar_para_actualizar(self):
        try:
            self.root.destroy()
        finally:
            os._exit(0)

