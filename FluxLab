def _version_tupla(version: str) -> tuple:
    return tuple(int(n) for n in re.findall(r"\d+", str(version)))

# ── Cache de actualizaciones (evita consultar GitHub en cada arranque) ────────
_UPDATE_CACHE = APP_DIR / "_update_cache.json"

def _leer_cache_update() -> dict:
    try:
        return json.loads(_UPDATE_CACHE.read_text(encoding="utf-8"))
    except Exception:
        return {}

def _guardar_cache_update(version: str) -> None:
    try:
        _UPDATE_CACHE.write_text(
            json.dumps({"version": version, "ts": time.time()},
                       ensure_ascii=False), encoding="utf-8")
    except Exception:
        pass

def _verificar_permiso_escritura() -> str:
    """Devuelve "" si podemos escribir en la carpeta del exe, o mensaje de error."""
    if not getattr(sys, "frozen", False):
        return "modo script"
    try:
        prueba = pathlib.Path(sys.executable).parent / "_wr_test_.tmp"
        prueba.write_bytes(b"ok")
        prueba.unlink()
        return ""
    except PermissionError:
        return ("Sin permisos de escritura en la carpeta del programa.\n"
                "Cierra FluxLab, haz clic derecho en el ícono → "
                "\"Ejecutar como administrador\" e intenta de nuevo.")
    except Exception as e:
        return f"No se puede escribir en la carpeta del programa: {e}"

def buscar_actualizacion():
    """
    Consulta la última Release de GitHub. Devuelve (version, url, tamaño)
    o None. Nunca lanza excepción.
    Protecciones incluidas:
      - Cache de 30 min para no spamear GitHub en cada arranque
      - Espera aleatoria 0-8 s para distribuir carga entre sucursales
      - Token opcional en config.json ("github_token") para repos privados
      - 3 reintentos con backoff si GitHub falla transitoriamente
    """
    if not GITHUB_REPO or "/" not in GITHUB_REPO or "TU_USUARIO" in GITHUB_REPO:
        return None

    # No consultar GitHub más de una vez cada 30 minutos
    cache = _leer_cache_update()
    if time.time() - cache.get("ts", 0) < 1800:
        ver_cache = cache.get("version", "")
        if not ver_cache or _version_tupla(ver_cache) <= _version_tupla(APP_VERSION):
            return None

    import urllib.request, random
    # Distribuir las consultas de todas las sucursales en 0-8 s
    time.sleep(random.uniform(0, 8))

    token = (_CONFIG.get("github_token") or os.getenv("GITHUB_TOKEN", "")).strip()
    headers = {"Accept": "application/vnd.github+json", "User-Agent": APP_NAME}
    if token:
        headers["Authorization"] = f"Bearer {token}"

    url = f"https://api.github.com/repos/{GITHUB_REPO}/releases/latest"
    for intento in range(3):
        try:
            with urllib.request.urlopen(
                    urllib.request.Request(url, headers=headers), timeout=15) as resp:
                datos = json.loads(resp.read().decode("utf-8"))
            version_remota = str(datos.get("tag_name", "")).strip().lstrip("vV")
            if not version_remota:
                return None
            _guardar_cache_update(version_remota)
            if _version_tupla(version_remota) <= _version_tupla(APP_VERSION):
                return None
            for asset in datos.get("assets", []):
                if str(asset.get("name", "")).lower().endswith(".exe"):
                    url_desc = asset.get("browser_download_url", "")
                    if url_desc:
                        return (version_remota, url_desc, int(asset.get("size", 0)))
            return None
        except Exception:
            if intento < 2:
                time.sleep(4 * (intento + 1))
    return None


def preparar_actualizacion(url_descarga: str, version_nueva: str,
                           tamano_esperado: int = 0, log_fn=None) -> bool:
    """
    Descarga, valida e instala la actualización de forma segura.
    Cubre: permisos, red lenta, antivirus, SmartScreen, proceso bloqueado.
    Usa PowerShell (más fiable que .bat) con fallback a .bat si PS falla.
    """
    L = log_fn or (lambda *_a, **_k: None)
    if not getattr(sys, "frozen", False):
        return False

    # ── 0. Verificar permisos ANTES de descargar nada ─────────────────────────
    error_perm = _verificar_permiso_escritura()
    if error_perm:
        L(f"  No se puede actualizar: {error_perm}")
        return False

    import urllib.request
    exe_actual = pathlib.Path(sys.executable)
    exe_nuevo  = exe_actual.with_name(exe_actual.stem + "_nuevo.exe")
    try:
        exe_nuevo.unlink(missing_ok=True)
    except Exception:
        pass

    # ── 1. Descarga con reintentos, timeout y progreso ────────────────────────
    descargado = False
    for intento in range(4):
        if intento > 0:
            espera = 5 * intento
            L(f"  Reintentando descarga en {espera}s (intento {intento + 1}/4)...")
            time.sleep(espera)
        try:
            req = urllib.request.Request(
                url_descarga, headers={"User-Agent": APP_NAME})
            with urllib.request.urlopen(req, timeout=240) as resp:
                total    = int(resp.headers.get("Content-Length", tamano_esperado) or 0)
                recibido = 0
                ultimo   = -1
                t_inicio = time.time()
                with open(exe_nuevo, "wb") as f:
                    while True:
                        chunk = resp.read(131072)
                        if not chunk:
                            break
                        f.write(chunk)
                        recibido += len(chunk)
                        if total:
                            pct = recibido * 100 // total
                            if pct // 5 != ultimo // 5:
                                ultimo  = pct
                                elapsed = time.time() - t_inicio or 0.1
                                vel     = recibido / elapsed / 1024
                                L(f"  Descargando {version_nueva}... {pct}%"
                                  f"  ({recibido/1_048_576:.1f}/{total/1_048_576:.1f} MB"
                                  f"  {vel:.0f} KB/s)")
            descargado = True
            break
        except Exception as e:
            L(f"  Error descarga (intento {intento + 1}/4): {e}")
            try:
                exe_nuevo.unlink(missing_ok=True)
            except Exception:
                pass

    if not descargado:
        L("  No se pudo descargar después de 4 intentos. Verifica tu conexión.")
        return False

    # ── 2. Detectar si el antivirus quarentenó el archivo ─────────────────────
    time.sleep(2)   # dar tiempo al antivirus para actuar
    if not exe_nuevo.exists():
        L("  El antivirus eliminó el archivo descargado (cuarentena).\n"
          "  Solución: agrega la carpeta de FluxLab a las exclusiones del antivirus"
          " y vuelve a intentarlo.")
        return False

    # ── 3. Validar tamaño ─────────────────────────────────────────────────────
    tamano_real = exe_nuevo.stat().st_size
    if tamano_esperado and abs(tamano_real - tamano_esperado) > 8192:
        L(f"  Archivo incompleto: {tamano_real:,} de {tamano_esperado:,} bytes.")
        exe_nuevo.unlink(missing_ok=True)
        return False

    if tamano_real < 1_000_000:
        L(f"  Archivo demasiado pequeño ({tamano_real:,} bytes) — posible error del servidor.")
        exe_nuevo.unlink(missing_ok=True)
        return False

    # ── 4. Validar header MZ (ejecutable Windows real) ────────────────────────
    try:
        with open(exe_nuevo, "rb") as f:
            if f.read(2) != b"MZ":
                L("  El archivo descargado no es un ejecutable válido (posible"
                  " página de error de GitHub en vez del .exe).")
                exe_nuevo.unlink(missing_ok=True)
                return False
    except Exception as e:
        L(f"  No se pudo verificar el ejecutable: {e}")
        exe_nuevo.unlink(missing_ok=True)
        return False

    L(f"  Archivo descargado y verificado: {tamano_real/1_048_576:.1f} MB  ✓")

    # ── 5. Script de instalación en PowerShell (más fiable que .bat) ──────────
    # PowerShell maneja mejor los permisos, la espera de proceso y el
    # relanzamiento. Se ejecuta con -ExecutionPolicy Bypass para que funcione
    # en cualquier PC sin importar la política de ejecución configurada.
    pid_app   = os.getpid()
    nombre    = exe_actual.name
    stem      = exe_actual.stem
    ps_path   = exe_actual.with_name("_actualizar_fluxlab.ps1")
    ps_script = (
        f"$viejo  = '{exe_actual}'\r\n"
        f"$nuevo  = '{exe_nuevo}'\r\n"
        f"$pidApp = {pid_app}\r\n"
        f"$nombre = '{nombre}'\r\n"
        f"$stem   = '{stem}'\r\n"
        "\r\n"
        "# 1. Esperar que cierre el proceso original\r\n"
        "while (Get-Process -Id $pidApp -ErrorAction SilentlyContinue) {\r\n"
        "    Start-Sleep -Seconds 1\r\n"
        "}\r\n"
        "\r\n"
        "# 2. Pausa para que el antivirus y Windows suelten los handles\r\n"
        "Start-Sleep -Seconds 6\r\n"
        "\r\n"
        "# 3. Reemplazar exe con reintentos (hasta 40 s)\r\n"
        "$ok = $false\r\n"
        "for ($i = 0; $i -lt 40; $i++) {\r\n"
        "    try {\r\n"
        "        Move-Item -Force -LiteralPath $nuevo -Destination $viejo -ErrorAction Stop\r\n"
        "        $ok = $true; break\r\n"
        "    } catch {\r\n"
        "        Start-Sleep -Seconds 1\r\n"
        "    }\r\n"
        "}\r\n"
        "\r\n"
        "if (-not $ok) {\r\n"
        "    Add-Type -AssemblyName System.Windows.Forms\r\n"
        "    [System.Windows.Forms.MessageBox]::Show(\r\n"
        "        'No se pudo instalar la actualizacion.' + [char]10 +\r\n"
        "        'Cierra cualquier ventana de FluxLab y vuelve a intentarlo,' + [char]10 +\r\n"
        "        'o reemplaza el .exe manualmente.',\r\n"
        "        'FluxLab - Error de actualizacion',\r\n"
        "        [System.Windows.Forms.MessageBoxButtons]::OK,\r\n"
        "        [System.Windows.Forms.MessageBoxIcon]::Warning) | Out-Null\r\n"
        "    exit 1\r\n"
        "}\r\n"
        "\r\n"
        "# 4. Relanzar la app (hasta 3 intentos)\r\n"
        "for ($j = 0; $j -lt 3; $j++) {\r\n"
        "    Start-Process -FilePath $viejo\r\n"
        "    Start-Sleep -Seconds 5\r\n"
        "    if (Get-Process -Name $stem -ErrorAction SilentlyContinue) { break }\r\n"
        "}\r\n"
        "\r\n"
        "# 5. Auto-borrar este script\r\n"
        "Remove-Item -LiteralPath $MyInvocation.MyCommand.Path -Force -ErrorAction SilentlyContinue\r\n"
    )

    try:
        ps_path.write_text(ps_script, encoding="utf-8")
    except Exception as e:
        L(f"  No se pudo escribir el script de instalación: {e}")
        exe_nuevo.unlink(missing_ok=True)
        return False

    import subprocess
    try:
        subprocess.Popen(
            ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
             "-WindowStyle", "Hidden", "-File", str(ps_path)],
            creationflags=subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP,
        )
        return True
    except Exception as e:
        # Fallback a .bat si PowerShell no está disponible
        L(f"  PowerShell no disponible ({e}), usando método alternativo...")
        bat_path = exe_actual.with_name("_actualizar_fluxlab.bat")
        bat = (
            "@echo off\r\nsetlocal enabledelayedexpansion\r\n"
            f"set PID={pid_app}\r\nset \"VIEJO={exe_actual}\"\r\n"
            f"set \"NUEVO={exe_nuevo}\"\r\nset \"NOMBRE={nombre}\"\r\n"
            ":w\r\ntasklist /FI \"PID eq %PID%\" 2>NUL | find \"%PID%\" >NUL\r\n"
            "if not errorlevel 1 (timeout /t 1 /nobreak >nul & goto w)\r\n"
            "timeout /t 6 /nobreak >nul\r\nset I=0\r\n"
            ":r\r\nmove /y \"%NUEVO%\" \"%VIEJO%\" >nul 2>&1\r\n"
            "if exist \"%NUEVO%\" (set /a I+=1 & if !I! LSS 40"
            " (timeout /t 1 /nobreak >nul & goto r))\r\n"
            "start \"\" \"%VIEJO%\"\r\ndel \"%~f0\"\r\n"
        )
        try:
            bat_path.write_text(bat, encoding="utf-8")
            subprocess.Popen(
                ["cmd", "/c", "start", "", str(bat_path)],
                creationflags=subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP,
            )
            return True
        except Exception as e2:
            L(f"  No se pudo lanzar el instalador: {e2}")
            exe_nuevo.unlink(missing_ok=True)
            return False

