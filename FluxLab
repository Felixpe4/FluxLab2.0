    def _mostrar_menu_usuario(self, event=None):
        menu = tk.Menu(self.root, tearoff=0,
                       bg=COLORS["bg_surface"], fg=COLORS["text"],
                       activebackground=COLORS["red_soft"],
                       activeforeground=COLORS["red"],
                       font=(FONT_UI, 9))
        menu.add_command(label="Cerrar sesión", command=self._cerrar_sesion)
        if event is not None:
            x = event.widget.winfo_rootx()
            y = event.widget.winfo_rooty() + event.widget.winfo_height()
        else:
            x = self.root.winfo_pointerx()
            y = self.root.winfo_pointery()
        menu.tk_popup(x, y)

    def _cerrar_sesion(self):
        with self.bots_lock:
            bots_corriendo = any(t.is_alive() for t in self.bots_activos.values())
        with self.etiquetas_lock:
            etiquetas_corriendo = any(t.is_alive() for t in self.etiquetas_activos.values())

        avisos = []
        if self.cola:
            avisos.append("Hay listas en la cola para ingresar.")
        if bots_corriendo or etiquetas_corriendo:
            avisos.append("Hay un bot en funcionamiento.")

        if avisos and not messagebox.askyesno(
            "Cerrar sesión",
            "\n".join(avisos) + "\n\n¿Seguro que quieres salir?",
            icon="warning", parent=self.root,
        ):
            return

        self.root.destroy()
        LoginWindow().run()

    # ─────────────────────────────────────────────────────────────────────────
    # HELPERS INTERNOS — SIN CAMBIOS DE LÓGICA
    # ─────────────────────────────────────────────────────────────────────────

    def _en_ui(self, fn, *args, **kwargs):
        if threading.current_thread() is self._main_thread:
            return fn(*args, **kwargs)
        try:
            self.root.after(0, lambda: fn(*args, **kwargs))
        except tk.TclError:
            pass
        return None

    def _normalizar_historial_item(self, data: dict, path=None) -> dict:
        item = data
        datos = item.get("data") if isinstance(item.get("data"), dict) else {}
        if not item.get("pacientes") and datos.get("pacientes"):
            item["pacientes"] = datos.get("pacientes", [])
        if "total" not in item:
            item["total"] = len(item.get("pacientes", [])) or datos.get("total", 0)
        if path:
            item["_historial_path"] = str(path)
        return item

    def _cargar_historial(self) -> list:
        items = []
        for path in HISTORIAL_DIR.glob("*.json"):
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
                items.append(self._normalizar_historial_item(data, path))
            except Exception:
                continue

        def clave(item):
            meta = item.get("_meta", {})
            return meta.get("timestamp_fin") or meta.get("timestamp") or ""

        return sorted(items, key=clave)

    def _guardar_historial_item(self, item: dict) -> None:
        path_txt = item.get("_historial_path")
        if path_txt:
            path = pathlib.Path(path_txt)
        else:
            ts = datetime.now().strftime("%Y%m%d_%H%M%S")
            path = HISTORIAL_DIR / f"{nombre_archivo_seguro(item.get('nombre', 'lista'))}_{ts}.json"
            item["_historial_path"] = str(path)
        serializable = {k: v for k, v in item.items() if k != "_historial_path"}
        path.write_text(json.dumps(serializable, ensure_ascii=False, indent=2),
                        encoding="utf-8")

    def _log(self, msg: str):
        if threading.current_thread() is not self._main_thread:
            self._en_ui(self._log, msg)
            return
        self.log_text.configure(state="normal")
        self.log_text.insert("end", f"  {msg}\n")
        self.log_text.see("end")
        self.log_text.configure(state="disabled")

    def _eliminar_lista(self):
        sel = self.lista_box.curselection()
        if not sel:
            self._log("Selecciona una lista para eliminar"); return
        idx  = sel[0]; hoja = self.cola[idx]
        if hoja["estado"] == "ingresando":
            messagebox.showwarning("En proceso",
                f"'{hoja['nombre']}' esta siendo procesada.\nDetén el bot primero."); return
        if messagebox.askyesno("Eliminar lista",
            f"¿Eliminar '{hoja['nombre']}' de la cola?\nEsta accion no se puede deshacer.",
            icon="warning"):
            self.cola.pop(idx); self._actualizar_lista()
            self._log(f"Lista eliminada: {hoja['nombre']}")

    def _drag_start(self, event):
        idx = self.lista_box.nearest(event.y)
        if 0 <= idx < len(self.cola):
            self._drag_idx = idx
            self.lista_box.selection_clear(0, tk.END)
            self.lista_box.selection_set(idx)

    def _drag_motion(self, event):
        if self._drag_idx is None: return
        target = self.lista_box.nearest(event.y)
        self.lista_box.selection_clear(0, tk.END)
        self.lista_box.selection_set(target)

    def _drag_release(self, event):
        if self._drag_idx is None: return
        target = self.lista_box.nearest(event.y)
        src = self._drag_idx; self._drag_idx = None
        if src == target or not (0 <= target < len(self.cola)):
            self.lista_box.selection_clear(0, tk.END)
            self.lista_box.selection_set(src); return
        hoja = self.cola.pop(src)
        self.cola.insert(target, hoja)
        self._actualizar_lista()
        self.lista_box.selection_clear(0, tk.END)
        self.lista_box.selection_set(target)
        self._log(f"Reordenado: '{hoja['nombre']}' -> posicion {target+1}")

    def _actualizar_lista(self):
        if threading.current_thread() is not self._main_thread:
            self._en_ui(self._actualizar_lista)
            return
        self.lista_box.delete(0, tk.END)
        iconos  = {"pendiente":"⏳ Pendiente", "extrayendo":"🔍 Extrayendo",
                   "listo":"✓ Listo", "validado":"✔ Validado",
                   "ingresando":"↑ Ingresando", "error":"✗ Error"}
        colores = {"pendiente":COLORS["text_muted"], "extrayendo":COLORS["amber"],
                   "listo":COLORS["blue"], "validado":COLORS["green"],
                   "ingresando":"#60A5FA", "error":COLORS["red"]}
        for hoja in self.cola:
            est   = hoja["estado"]
            data  = hoja.get("data") or {}
            total_n = data.get("total", len(data.get("pacientes", [])))
            total = f"  {total_n}p" if data else ""
            tag   = iconos.get(est, est.title())
            with self.bots_lock:
                tiene_bot = hoja["nombre"] in self.bots_activos and \
                            self.bots_activos[hoja["nombre"]].is_alive()
            bot_ind = " [BOT]" if tiene_bot else ""
            self.lista_box.insert(tk.END, f"  {tag}  {hoja['nombre']}{total}{bot_ind}")
            self.lista_box.itemconfig(
                self.lista_box.size()-1, fg=colores.get(est, COLORS["text"]))

        if hasattr(self, "metric_vars"):
            with self.bots_lock:
                n_bots_ingreso = sum(1 for t in self.bots_activos.values() if t.is_alive())
            with self.etiquetas_lock:
                n_bots_etiq = sum(1 for t in self.etiquetas_activos.values() if t.is_alive())
            total_bots = n_bots_ingreso + n_bots_etiq
            self.metric_vars["cola"].set(str(len(self.cola)))
            self.metric_vars["historial"].set(str(len(self.historial)))
            self.metric_vars["bots"].set(str(total_bots))
            self.metric_vars["errores"].set(str(len([h for h in self.cola if h.get("estado") == "error"])))

    def _cargar(self):
        rutas = filedialog.askopenfilenames(
            title="Seleccionar hojas",
            filetypes=[
                ("Todos los formatos","*.jpg *.jpeg *.png *.jfif *.webp *.pdf"),
                ("Imagenes","*.jpg *.jpeg *.png *.jfif *.webp"),
                ("PDF escaner","*.pdf"),
            ])
        if not rutas: return
        existentes = {h["ruta"] for h in self.cola}
        nuevas = 0
        for r in rutas:
            if r in existentes: continue
            self.cola.append({"ruta":r,"nombre":pathlib.Path(r).name,
                               "estado":"pendiente","data":None,
                               "ingreso":None,"json_path":None})
            nuevas += 1
        if nuevas:
            self._log(f"{nuevas} hoja(s) agregadas"); self._actualizar_lista()
            threading.Thread(target=self._extraer_todas, daemon=True).start()
        else:
            self._log("Hojas ya estaban en la cola")

    def _extraer_todas(self):
        pendientes = [h for h in self.cola if h["estado"] == "pendiente"]
        if not pendientes: return
        for hoja in pendientes:
            hoja["estado"] = "extrayendo"; self._actualizar_lista()
            self._log(f"\nProcesando: {hoja['nombre']}")
            try:
                data = extraer_pacientes(hoja["ruta"], self._log)
                hoja["data"] = data; hoja["estado"] = "listo"
                self._log(f"  OK: {hoja['nombre']} -> {data['total']} pacientes")
            except Exception as e:
                hoja["estado"] = "error"; self._log(f"  Error: {e}")
            self._actualizar_lista()
        self._log("\nExtraccion completada.")

    def _abrir_validacion(self, hoja):
        if hoja["estado"] not in ("listo","validado"): return
        ValidacionWindow(self.root, hoja, self._log, self._actualizar_lista)

    def _editar_lista(self):
        sel = self.lista_box.curselection()
        if not sel: self._log("Selecciona una hoja primero"); return
        hoja = self.cola[sel[0]]
        if hoja["estado"] not in ("listo","validado"):
            self._log("La hoja debe estar en listo o validado para editar"); return
        self._abrir_validacion(hoja)

    def _doble_click_lista(self, event):
        idx = self.lista_box.nearest(event.y)
        if idx < 0 or idx >= len(self.cola): return
        self.lista_box.selection_clear(0, tk.END)
        self.lista_box.selection_set(idx)
        hoja = self.cola[idx]
        if hoja["estado"] not in ("listo","validado"):
            self._log("La hoja debe estar en listo o validado para editar"); return
        self._abrir_validacion(hoja)

    # ── Iniciar UN bot en la lista seleccionada (multibot controlado) ─────────
    def _iniciar(self):
        sel = self.lista_box.curselection()
        if not sel:
            try:
                messagebox.showwarning(
                    "Selecciona una lista",
                    "Debe seleccionar una lista de la cola antes de iniciar el bot.")
            except Exception:
                pass
            self._log("Debe seleccionar una lista antes de iniciar el bot")
            return

        idx    = sel[0]
        hoja   = self.cola[idx]
        nombre = hoja["nombre"]

        if hoja["estado"] != "validado":
            try:
                messagebox.showwarning(
                    "Lista no validada",
                    f"'{nombre}' no esta validada.\nValida primero con el boton Editar.")
            except Exception:
                pass
            self._log(f"'{nombre}' no esta validada — valida primero con Editar")
            return

        with self.bots_lock:
            ya_corre = nombre in self.bots_activos and \
                       self.bots_activos[nombre].is_alive()
            if ya_corre:
                self._log(f"Ya hay un bot activo en: {nombre}")
                return
            # Reserva atomica: marcar como ingresando antes de lanzar el hilo
            self.detener_bots.discard(nombre)
            hoja["estado"] = "ingresando"
            t = threading.Thread(target=self._lanzar_bot_lista, args=(hoja,),
                                 daemon=True, name=f"bot-ingreso-{nombre}")
            self.bots_activos[nombre] = t

        t.start()
        self._log(f"Bot lanzado en: {nombre} (continuara hacia abajo cuando termine)")
        self._actualizar_lista()

    def _detener(self):
        sel = self.lista_box.curselection()
        if sel:
            hoja = self.cola[sel[0]]; nombre = hoja["nombre"]
            with self.bots_lock:
                tiene_bot = nombre in self.bots_activos and \
                            self.bots_activos[nombre].is_alive()
            if tiene_bot:
                self.detener_bots.add(nombre)
                self._log(f"Senal de detencion enviada: {nombre}")
            else:
                self._log(f"No hay bot activo para: {nombre}")
        else:
            with self.bots_lock:
                activos = [n for n, t in self.bots_activos.items() if t.is_alive()]
            if not activos:
                self._log("No hay bots activos en este momento"); return
            for nombre in activos:
                self.detener_bots.add(nombre)
            self._log(f"Senal de detencion enviada a {len(activos)} bot(s) activo(s)")

    def _ver_historial(self):
        self.historial = self._cargar_historial()
        HistorialWindow(self.root, self.historial,
                        self._iniciar_etiquetas,
                        eliminar_fn=self._on_historial_eliminado)

    def _on_historial_eliminado(self, h: dict):
        if h in self.historial:
            self.historial.remove(h)
        self._actualizar_lista()

    def _archivar_hoja(self, hoja, resultado):
        item = None
        try:
            if hoja.get("json_path"):
                src = pathlib.Path(hoja["json_path"])
                if src.exists():
                    item = json.loads(src.read_text(encoding="utf-8"))
        except Exception as e:
            self._log(f"  Advertencia leyendo validado: {e}")

        if item is None:
            item = {
                "pacientes": hoja.get("data", {}).get("pacientes", []),
                "total":     hoja.get("data", {}).get("total", 0),
                "ingreso":   hoja.get("ingreso", {}),
                "nombre":    hoja.get("nombre", "lista"),
                "_meta":     {"imagen": hoja.get("nombre", "lista")},
            }

        meta = item.setdefault("_meta", {})
        meta["timestamp_fin"] = datetime.now().isoformat()
        meta["resultado"]     = resultado
        item = self._normalizar_historial_item(item)
        self._guardar_historial_item(item)
        self.historial.append(item)
        if hoja in self.cola:
            self.cola.remove(hoja)
        self._actualizar_lista()
        return item

    def _contar_pacientes_hoy(self) -> int:
        hoy   = datetime.now().strftime("%Y-%m-%d")
        total = 0
        for path in HISTORIAL_DIR.glob("*.json"):
            try:
                data   = json.loads(path.read_text(encoding="utf-8"))
                meta   = data.get("_meta", {})
                ts     = meta.get("timestamp_fin") or meta.get("timestamp") or ""
                if not ts.startswith(hoy): continue
                resultado = meta.get("resultado", {})
                ok = resultado.get("ok", 0)
                total += ok if isinstance(ok, int) else len(data.get("pacientes", []))
            except Exception:
                continue
        return total

    def _actualizar_pac_hoy(self):
        try:
            n = self._contar_pacientes_hoy()
            self.metric_vars["pac_hoy"].set(str(n))
        except Exception:
            pass
        self.root.after(60_000, self._actualizar_pac_hoy)

    # ── BOT INGRESO PARALELO ──────────────────────────────────────────────────
    def _lanzar_bot_lista(self, hoja: dict):
        try:
            from playwright.sync_api import sync_playwright, TimeoutError as PWT
        except ImportError:
            self._log("pip install playwright  ->  playwright install chromium")
            if hoja.get("estado") == "ingresando":
                hoja["estado"] = "validado"
            with self.bots_lock:
                self.bots_activos.pop(hoja["nombre"], None)
            self._actualizar_lista()
            return

        if not LAB_USER or not LAB_PASS:
            self._log("Faltan LAB_BOT_USER o LAB_BOT_PASS")
            if hoja.get("estado") == "ingresando":
                hoja["estado"] = "validado"
            with self.bots_lock:
                self.bots_activos.pop(hoja["nombre"], None)
            self._actualizar_lista()
            return

        LAB_URL     = f"{LAB_BASE_URL}/nuevo"
        T_PAC       = 1.8
        MAX_INT     = 4
        L           = self._log
        nombre_hoja = hoja["nombre"]
        tag         = f"[{nombre_hoja[:20]}] "

        def esperar(page, sel, t=7000):
            try: page.wait_for_selector(sel, state="visible", timeout=t); return True
            except PWT: return False

        def esperar_hab(page, sel, t=8000):
            try: page.wait_for_selector(f"{sel}:not([disabled])", timeout=t); return True
            except PWT: L(f"{tag}No habilitado: {sel}"); return False

        def modal_vis(page):
            try: return page.locator(".swal2-popup.swal2-show").is_visible(timeout=1500)
            except: return False

        def leer_modal(page):
            titulo = sub = ""
            try: titulo = page.locator("#swal2-title").inner_text(timeout=2000).strip()
            except: pass
            try: sub = page.locator("#swal2-content").inner_text(timeout=2000).strip()
            except: pass
            return titulo, sub

        def cerrar_ok(page):
            try: page.locator(".swal2-confirm").click(timeout=3000); time.sleep(0.8)
            except: pass

        def cerrar_esc(page):
            page.keyboard.press("Escape"); time.sleep(1.0)

        def num_a_ctrl(numero):
            n = str(numero).replace("/","").strip()
            return f"{n[:6]}/{n[6:]}" if len(n)>=10 else f"260323/0{n.zfill(3)}"

        def escribir(page, sel, texto, delay=70):
            page.fill(sel,""); time.sleep(0.3); page.type(sel, texto, delay=delay)


        def estudio_autocomplete_igual(texto_web: str, buscar: str) -> bool:
            """
            Compara el texto del autocomplete con el estudio buscado.
            Normaliza acentos, mayúsculas y espacios extra.
            """
            a = texto_plano(str(texto_web))
            b = texto_plano(str(buscar))
            if not a or not b:
                return False
            # Coincidencia exacta normalizada
            if a == b:
                return True
            # El texto web contiene completamente el término buscado
            if b in a:
                return True
            return False

        def autocomplete(page, buscar, t=9000, exacto=False, estudio=False):
            try:
                page.wait_for_selector(
                    "ul.ui-autocomplete:visible li.ui-menu-item",
                    timeout=t
                )
            except PWT:
                L(f"{tag}Sin autocomplete: {buscar}")
                return False

            items = page.locator(
                "ul.ui-autocomplete:visible li.ui-menu-item"
            )

            count = items.count()

            # Selección manual para estudios ambiguos (ver SELECCION_MANUAL_ESTUDIOS)
            if estudio:
                veces = SELECCION_MANUAL_ESTUDIOS.get(texto_plano(buscar))
                if veces is not None:
                    for _ in range(veces):
                        page.keyboard.press("ArrowDown")
                        time.sleep(0.15)
                    page.keyboard.press("Enter")
                    time.sleep(0.5)
                    L(f"{tag}Selección manual '{buscar}': flecha abajo x{veces} + Enter")
                    return True

            # NUEVA REGLA
            # Si solo existe una opción, seleccionarla SIEMPRE
            # (excepto en busqueda exacta de paciente: debe coincidir 100%)
            if count == 1 and not exacto:
                texto = items.first.inner_text().strip()
                L(f"  Unica opcion encontrada: {texto}")
                items.first.click()
                time.sleep(0.5)
                return True

            bu = buscar.strip()

            # Coincidencia exacta
            for i in range(count):
                txt = items.nth(i).inner_text().strip()

                if estudio and estudio_autocomplete_igual(txt, bu):
                    items.nth(i).click()
                    time.sleep(0.5)
                    return True

                if not estudio and nombre_paciente_igual(txt, bu):
                    items.nth(i).click()
                    time.sleep(0.5)
                    return True

            # Si hay varias opciones y se pidió exactitud
            if estudio:
                opciones = []
                for i in range(min(count, 8)):
                    try:
                        opciones.append(items.nth(i).inner_text().strip())
                    except:
                        pass
                L(f"  Sin coincidencia segura de estudio para '{buscar}'. Opciones: {opciones}")
                return False

            if exacto:
                opciones = []

                for i in range(min(count, 8)):
                    try:
                        opciones.append(
                            items.nth(i).inner_text().strip()
                        )
                    except:
                        pass

                L(
                    f"  Sin coincidencia exacta para "
                    f"'{buscar}'. Opciones: {opciones}"
                )
                return False

            # Coincidencia parcial
            for i in range(count):
                txt = items.nth(i).inner_text().strip().upper()

                if bu.upper() in txt or txt in bu.upper():
                    items.nth(i).click()
                    time.sleep(0.5)
                    return True

            return False

        def crear_paciente(page, pac):
            nombre      = pac.get("nombre", "")
            edad_val    = str(pac.get("edad", "")).strip()
            fecha_nac   = str(pac.get("fecha_nacimiento", "")).strip()
            sexo_val    = str(pac.get("sexo", "")).strip().upper()

            L(f"{tag}Creando paciente: {nombre} | Edad: '{edad_val}' | F.Nac: '{fecha_nac}' | Sexo: '{sexo_val}'")
            try: page.locator("button.btn-info").first.click(timeout=3000)
            except: page.keyboard.press("Tab"); time.sleep(0.3); page.keyboard.press("Enter")
            time.sleep(2)
            if not esperar(page,"#apellido_paterno",6000): L(f"{tag}No abrio modal"); return
            ps = nombre.strip().split()
            apellido_paterno = ps[0] if ps else ""
            apellido_materno = ps[1] if len(ps) > 2 else ""
            nombre_paciente = " ".join(ps[2:]) if len(ps) > 2 else (ps[-1] if ps else "")
            page.fill("#apellido_paterno", apellido_paterno)
            page.keyboard.press("Tab"); page.keyboard.type(apellido_materno)
            page.keyboard.press("Tab"); page.keyboard.type(nombre_paciente)

            if fecha_nac:
                partes = fecha_nac.replace("-", "/").split("/")
                if len(partes) == 3:
                    dia_v, mes_v, ano_v = partes[0].strip(), partes[1].strip(), partes[2].strip()
                    L(f"{tag}  Fecha nacimiento detectada (ignorada temporalmente): {dia_v}/{mes_v}/{ano_v}; edad=0")
                else:
                    L(f"{tag}  Fecha no parseable '{fecha_nac}' (ignorada temporalmente); edad=0")
            edad_ingreso = edad_para_ingreso(edad_val, fecha_nac)
            L(f"{tag}  Edad a ingresar: {edad_ingreso}")
            try:
                loc = page.locator("#edad").first
                loc.fill(""); page.wait_for_timeout(200)
                loc.type(edad_ingreso, delay=60)
            except Exception as e:
                L(f"{tag}  Fallback Tab para #edad: {e}")
                try:
                    for _ in range(5): page.keyboard.press("Tab")
                    page.keyboard.type(edad_ingreso)
                except Exception: pass

            if sexo_val == "M":
                L(f"{tag}  Sexo: Masculino")
                try: page.select_option("#sexo", "Masculino")
                except Exception as e: L(f"{tag}  #sexo error: {e}")
            else:
                L(f"{tag}  Sexo: vacío → sistema asigna Femenino automáticamente")

            page.click("#NuevoCliente"); time.sleep(3)
            if modal_vis(page):
                titulo, _ = leer_modal(page)
                if "ya existe" in titulo.lower() or "base de datos" in titulo.lower():
                    L(f"{tag}Paciente ya existe; reintentare seleccion exacta")
                    for _ in range(2):
                        cerrar_esc(page)
                    return "existe"
                L(f"{tag}Modal creando paciente: '{titulo}'")
                cerrar_ok(page)
                return "modal"
            L(f"{tag}Paciente creado")
            return "creado"

        def seleccionar_paciente(page, pac) -> bool:
            nombre = pac.get("nombre", "").strip()
            if not nombre:
                return False

            # 1) Buscar tal cual esta escrito en la lista
            escribir(page, "#nuevo_cliente", nombre, delay=85)
            if autocomplete(page, nombre, t=12000, exacto=True):
                return True

            # 2) Buscar con punto final (variante ya registrada en el sistema)
            nombre_pto = nombre_con_punto(nombre)
            escribir(page, "#nuevo_cliente", nombre_pto, delay=85)
            if autocomplete(page, nombre_pto, t=12000, exacto=True):
                return True

            # 3) No existe -> crear paciente nuevo, siempre con punto final
            pac_pto = pac.copy()
            pac_pto["nombre"] = nombre_pto
            L(f"{tag}No existe '{nombre}' ni '{nombre_pto}'; creare paciente nuevo: {nombre_pto}")
            crear_paciente(page, pac_pto)
            time.sleep(1)
            escribir(page, "#nuevo_cliente", nombre_pto, delay=85)
            if autocomplete(page, nombre_pto, t=14000, exacto=True):
                return True

            L(f"{tag}No pude seleccionar paciente exacto: {nombre}")
            return False

        def ingresar_campos(page, pac, ing):
            tag = "  "
            nombre   = pac.get("nombre","")
            control  = num_a_ctrl(pac.get("numero",""))
            estudios = pac.get("estudios",[])
            L(f"{tag}Paciente: {nombre}")
            if not seleccionar_paciente(page, pac):
                raise RuntimeError(f"No encontre/cree paciente exacto: {nombre}")
            time.sleep(0.6)
            L(f"{tag}Doctor: {ing['doctor']}")
            escribir(page,"#nuevo_medico", ing["doctor"])
            if not autocomplete(page, ing["doctor"]): L(f"{tag}Doctor no encontrado")
            page.fill("#observaciones", ing["observacion"]); time.sleep(0.2)
            try: page.select_option("#empresa", value=str(ing["empresa"])); L(f"{tag}Empresa: {ing['empresa']}")
            except Exception as e: L(f"{tag}Empresa error: {e}")
            time.sleep(0.3)
            page.fill("#controlInterno", control); time.sleep(0.2)
            page.fill("#procedencia", str(ing["procedencia"])); time.sleep(0.2)
            L(f"{tag}Esperando campo estudios...")
            esperar_hab(page,"#AgregarEstudios")
            agregados = 0
            for est in estudios:
                L(f"{tag}Estudio: {est}")
                try:
                    page.wait_for_selector("#AgregarEstudios:not([disabled])", timeout=5000)
                    escribir(page,"#AgregarEstudios", est, delay=55)
                    if autocomplete(page, est, t=4000, estudio=True):
                        agregados += 1; time.sleep(0.4); page.fill("#AgregarEstudios","")
                    else: L(f"{tag}No encontrado: {est}")
                except PWT: L(f"{tag}Campo deshabilitado: {est}")
            if agregados == 0: L(f"{tag}Ningun estudio agregado")

        def guardar(page, pac, ing):
            for intento in range(1, MAX_INT+1):
                L(f"{tag}Guardando ({intento}/{MAX_INT})...")
                page.click("#imprimir"); time.sleep(2.5)
                if not modal_vis(page):
                    L(f"{tag}Guardado OK")
                    for _ in range(3): page.keyboard.press("Escape"); time.sleep(0.3)
                    return True
                titulo, sub = leer_modal(page)
                try: es_exito = page.locator(".swal2-icon.swal2-success").is_visible(timeout=800)
                except: es_exito = False
                if es_exito or any(p in titulo.lower() for p in ["guardad","exito","correcto","registr"]):
                    L(f"{tag}Ingresado correctamente"); cerrar_esc(page); return True
                if "doctor" in sub.lower() or "doctor" in titulo.lower():
                    L(f"{tag}Sin doctor, reseleccionando..."); cerrar_ok(page)
                    escribir(page,"#nuevo_medico", ing["doctor"]); autocomplete(page, ing["doctor"]); continue
                if "faltan" in titulo.lower() or "campos" in titulo.lower():
                    cerrar_ok(page)
                    try: filas = page.locator("table tbody tr").count(); gran = page.locator("#gran_total").input_value(timeout=1000)
                    except: filas, gran = -1,"?"
                    if filas == 0 or gran == "0.00":
                        L(f"{tag}Faltan estudios, reagregando...")
                        esperar_hab(page,"#AgregarEstudios")
                        for est in pac.get("estudios",[]):
                            page.wait_for_selector("#AgregarEstudios:not([disabled])",timeout=4000)
                            escribir(page,"#AgregarEstudios",est,delay=50)
                            if autocomplete(page,est,t=3000, estudio=True): time.sleep(0.3); page.fill("#AgregarEstudios","")
                    else:
                        L(f"{tag}Falta paciente, reseleccionando...")
                        if not seleccionar_paciente(page, pac):
                            return False
                    continue
                L(f"{tag}Modal desconocido: '{titulo}'"); cerrar_ok(page); time.sleep(1)
            L(f"{tag}Fallo tras {MAX_INT} intentos"); return False

        # Reclama atomicamente la siguiente hoja "validado" hacia abajo desde
        # idx_inicio. Salta las que esten en estados intermedios (pendiente,
        # extrayendo, listo, error). Si encuentra una "ingresando" (otro bot
        # ya esta trabajando esa lista), este bot se cierra: el otro continuara
        # desde ahi en adelante para evitar dos bots procesando lo mismo o
        # adelantarse en orden.
        def _reclamar_siguiente(nombre_actual: str, idx_inicio: int):
            with self.bots_lock:
                this_thread = self.bots_activos.get(nombre_actual)
                for j in range(max(0, idx_inicio), len(self.cola)):
                    cand = self.cola[j]
                    est  = cand.get("estado")
                    cn   = cand["nombre"]
                    if est == "ingresando":
                        # Otro bot ya tiene esta lista. Este bot se retira.
                        L(f"  Lista '{cn}' ya tiene bot — cerrando este bot, el otro continuara")
                        self.bots_activos.pop(nombre_actual, None)
                        return None
                    if est != "validado":
                        L(f"  Saltando '{cn}' (estado: {est})")
                        continue
                    if cn in self.bots_activos and self.bots_activos[cn].is_alive() \
                       and self.bots_activos[cn] is not this_thread:
                        # Caso defensivo: registrada como validada pero con bot vivo.
                        L(f"  Lista '{cn}' ya tiene bot vivo — cerrando este bot")
                        self.bots_activos.pop(nombre_actual, None)
                        return None
                    # Reclamar: mover registro y marcar como ingresando
                    self.bots_activos.pop(nombre_actual, None)
                    if this_thread is not None:
                        self.bots_activos[cn] = this_thread
                    cand["estado"] = "ingresando"
                    return cand
                # No hay candidato: desregistrar este bot
                self.bots_activos.pop(nombre_actual, None)
                return None

        hoja_actual = hoja
        try:
            with sync_playwright() as pw:
                browser = pw.chromium.launch(headless=False)
                page    = browser.new_page()

                L(f"\n{'='*50}")
                L(f"{tag}BOT PARALELO INICIADO")
                L(f"{'='*50}")
                L(f"{tag}Login...")
                page.goto(LAB_URL); esperar(page,"#ingUsuario")
                page.fill("#ingUsuario", LAB_USER)
                page.fill('input[name="ingPassword"]', LAB_PASS)
                page.click('button:has-text("Ingresar")'); time.sleep(4)
                esperar(page,"i.fa-file")
                page.locator("i.fa-file").first.click(force=True); time.sleep(2)
                manejar_apertura_caja(page, L, tag)
                L(f"{tag}En modulo de ingreso")

                while hoja_actual is not None:
                    nombre_hoja = hoja_actual["nombre"]
                    tag         = f"[{nombre_hoja[:20]}] "

                    if nombre_hoja in self.detener_bots:
                        L(f"{tag}Detenido antes de ingresar")
                        hoja_actual["estado"] = "validado"
                        with self.bots_lock:
                            self.bots_activos.pop(nombre_hoja, None)
                        self._actualizar_lista()
                        break

                    # _iniciar / _reclamar_siguiente ya dejaron la hoja en "ingresando".
                    # Aceptamos ambos por si acaso el estado fue tocado externamente.
                    if hoja_actual["estado"] not in ("ingresando", "validado"):
                        L(f"{tag}Estado inesperado ({hoja_actual['estado']}), saltando")
                    else:
                        if hoja_actual["estado"] != "ingresando":
                            hoja_actual["estado"] = "ingresando"
                        self._actualizar_lista()

                        try:
                            data      = json.loads(pathlib.Path(hoja_actual["json_path"]).read_text(encoding="utf-8"))
                            pacientes = data["pacientes"]; ingreso = data["ingreso"]
                        except Exception as e:
                            L(f"{tag}Error leyendo JSON: {e}")
                            hoja_actual["estado"] = "error"
                            self._actualizar_lista()
                            with self.bots_lock:
                                self.bots_activos.pop(nombre_hoja, None)
                            break

                        total = len(pacientes); ok_count = 0; fallidos = []
                        L(f"{tag}{total} pacientes a ingresar")

                        for i, pac in enumerate(pacientes, 1):
                            if nombre_hoja in self.detener_bots or page.is_closed():
                                L(f"{tag}Detenido en paciente {i}/{total}")
                                break
                            L(f"{tag}[{i}/{total}] {pac.get('nombre','?')}")
                            try:
                                ingresar_campos(page, pac, ingreso)
                                ok = guardar(page, pac, ingreso)
                                if ok: ok_count += 1
                                else:  fallidos.append(pac.get("nombre","?"))
                            except Exception as e:
                                L(f"{tag}Error: {e}"); fallidos.append(pac.get("nombre","?"))
                                try: page.goto(LAB_URL); time.sleep(2)
                                except: pass
                            time.sleep(T_PAC)

                        resultado = {"ok": ok_count, "total": total, "fallidos": fallidos}
                        L(f"\n{tag}Resultado: {ok_count}/{total} OK")
                        if fallidos:
                            L(f"{tag}Fallidos: {', '.join(fallidos)}")

                        # Capturar el indice ANTES de archivar (que remueve de la cola).
                        # La siguiente hoja a evaluar ocupara ese mismo indice.
                        try:
                            idx_terminada = self.cola.index(hoja_actual)
                        except ValueError:
                            idx_terminada = len(self.cola)

                        self._archivar_hoja(hoja_actual, resultado)
                        L(f"{tag}Lista archivada en historial")

                        self._en_ui(self._actualizar_pac_hoy)

                        L(f"{tag}Etiquetas: pendientes — saca desde Historial manualmente")

                        if nombre_hoja in self.detener_bots:
                            L(f"{tag}Bot detenido; no buscara siguiente lista")
                            with self.bots_lock:
                                self.bots_activos.pop(nombre_hoja, None)
                            self._actualizar_lista()
                            break

                        # Buscar la siguiente lista validada disponible hacia abajo
                        siguiente = _reclamar_siguiente(nombre_hoja, idx_terminada)
                        self._actualizar_lista()
                        if siguiente is None:
                            L(f"{tag}Sin mas listas disponibles — bot descansa")
                            break
                        L(f"{tag}>>> Continuando con: {siguiente['nombre']}")
                        hoja_actual = siguiente
                        continue

                    # Llego aqui si el estado era inesperado: intentar la siguiente
                    try:
                        idx_terminada = self.cola.index(hoja_actual) + 1
                    except ValueError:
                        idx_terminada = len(self.cola)
                    siguiente = _reclamar_siguiente(nombre_hoja, idx_terminada)
                    self._actualizar_lista()
                    if siguiente is None:
                        break
                    hoja_actual = siguiente

                if not page.is_closed():
                    browser.close()

        except Exception as e:
            L(f"Error fatal en bot: {e}")
            try:
                if hoja_actual in self.cola:
                    hoja_actual["estado"] = "error"
            except Exception:
                pass
            self._actualizar_lista()

        finally:
            # Limpieza: quitar cualquier registro de este hilo en bots_activos
            with self.bots_lock:
                me = threading.current_thread()
                for nm in list(self.bots_activos.keys()):
                    if self.bots_activos[nm] is me:
                        self.bots_activos.pop(nm, None)
            self.detener_bots.discard(hoja["nombre"])
            L(f"Bot finalizado")
            self._actualizar_lista()

    # ── BOT SECUENCIAL LEGACY ─────────────────────────────────────────────────
    def _lanzar_bot_secuencial(self, idx_inicio: int):
        try:
            from playwright.sync_api import sync_playwright, TimeoutError as PWT
        except ImportError:
            self._log("pip install playwright  ->  playwright install chromium")
            self.bot_activo = False; return

        if not LAB_USER or not LAB_PASS:
            self._log("Faltan LAB_BOT_USER o LAB_BOT_PASS")
            self.bot_activo = False; return
        LAB_URL  = f"{LAB_BASE_URL}/nuevo"
        T_PAC = 1.8; MAX_INT = 4; L = self._log

        def esperar(page, sel, t=7000):
            try: page.wait_for_selector(sel, state="visible", timeout=t); return True
            except PWT: return False

        def esperar_hab(page, sel, t=8000):
            try: page.wait_for_selector(f"{sel}:not([disabled])", timeout=t); return True
            except PWT: L(f"  No habilitado: {sel}"); return False

        def modal_vis(page):
            try: return page.locator(".swal2-popup.swal2-show").is_visible(timeout=1500)
            except: return False

        def leer_modal(page):
            titulo = sub = ""
            try: titulo = page.locator("#swal2-title").inner_text(timeout=2000).strip()
            except: pass
            try: sub = page.locator("#swal2-content").inner_text(timeout=2000).strip()
            except: pass
            return titulo, sub

        def cerrar_ok(page):
            try: page.locator(".swal2-confirm").click(timeout=3000); time.sleep(0.8)
            except: pass

        def cerrar_esc(page):
            page.keyboard.press("Escape"); time.sleep(1.0)

        def num_a_ctrl(numero):
            n = str(numero).replace("/","").strip()
            return f"{n[:6]}/{n[6:]}" if len(n)>=10 else f"260323/0{n.zfill(3)}"

        def escribir(page, sel, texto, delay=70):
            page.fill(sel,""); time.sleep(0.3); page.type(sel, texto, delay=delay)


        def estudio_autocomplete_igual(texto_web: str, buscar: str) -> bool:
            """
            Compara el texto del autocomplete con el estudio buscado.
            Normaliza acentos, mayúsculas y espacios extra.
            """
            a = texto_plano(str(texto_web))
            b = texto_plano(str(buscar))
            if not a or not b:
                return False
            # Coincidencia exacta normalizada
            if a == b:
                return True
            # El texto web contiene completamente el término buscado
            if b in a:
                return True
            return False

        def autocomplete(page, buscar, t=9000, exacto=False, estudio=False):
            try:
                page.wait_for_selector(
                    "ul.ui-autocomplete:visible li.ui-menu-item",
                    timeout=t
                )
            except PWT:
                L(f"  Sin autocomplete: {buscar}")
                return False

            items = page.locator(
                "ul.ui-autocomplete:visible li.ui-menu-item"
            )

            count = items.count()

            # Selección manual para estudios ambiguos (ver SELECCION_MANUAL_ESTUDIOS)
            if estudio:
                veces = SELECCION_MANUAL_ESTUDIOS.get(texto_plano(buscar))
                if veces is not None:
                    for _ in range(veces):
                        page.keyboard.press("ArrowDown")
                        time.sleep(0.15)
                    page.keyboard.press("Enter")
                    time.sleep(0.5)
                    L(f"  Selección manual '{buscar}': flecha abajo x{veces} + Enter")
                    return True

            # NUEVA REGLA
            # Si solo existe una opción, seleccionarla SIEMPRE
            # (excepto en busqueda exacta de paciente: debe coincidir 100%)
            if count == 1 and not exacto:
                texto = items.first.inner_text().strip()
                L(f"  Unica opcion encontrada: {texto}")
                items.first.click()
                time.sleep(0.5)
                return True

            bu = buscar.strip()

            # Coincidencia exacta
            for i in range(count):
                txt = items.nth(i).inner_text().strip()

                if estudio and estudio_autocomplete_igual(txt, bu):
                    items.nth(i).click()
                    time.sleep(0.5)
                    return True

                if not estudio and nombre_paciente_igual(txt, bu):
                    items.nth(i).click()
                    time.sleep(0.5)
                    return True

            # Si hay varias opciones y se pidió exactitud
            if estudio:
                opciones = []
                for i in range(min(count, 8)):
                    try:
                        opciones.append(items.nth(i).inner_text().strip())
                    except:
                        pass
                L(f"  Sin coincidencia segura de estudio para '{buscar}'. Opciones: {opciones}")
                return False

            if exacto:
                opciones = []

                for i in range(min(count, 8)):
                    try:
                        opciones.append(
                            items.nth(i).inner_text().strip()
                        )
                    except:
                        pass

                L(
                    f"  Sin coincidencia exacta para "
                    f"'{buscar}'. Opciones: {opciones}"
                )
                return False

            # Coincidencia parcial
            for i in range(count):
                txt = items.nth(i).inner_text().strip().upper()

                if bu.upper() in txt or txt in bu.upper():
                    items.nth(i).click()
                    time.sleep(0.5)
                    return True

            return False

        def crear_paciente(page, pac):
            nombre      = pac.get("nombre", "")
            edad_val    = str(pac.get("edad", "")).strip()
            fecha_nac   = str(pac.get("fecha_nacimiento", "")).strip()
            sexo_val    = str(pac.get("sexo", "")).strip().upper()

            L(f"  Creando: {nombre} | Edad: '{edad_val}' | F.Nac: '{fecha_nac}' | Sexo: '{sexo_val}'")
            try: page.locator("button.btn-info").first.click(timeout=3000)
            except: page.keyboard.press("Tab"); time.sleep(0.3); page.keyboard.press("Enter")
            time.sleep(2)
            if not esperar(page,"#apellido_paterno",6000): L("  No abrio modal"); return
            ps = nombre.strip().split()
            apellido_paterno = ps[0] if ps else ""
            apellido_materno = ps[1] if len(ps) > 2 else ""
            nombre_paciente = " ".join(ps[2:]) if len(ps) > 2 else (ps[-1] if ps else "")
            page.fill("#apellido_paterno", apellido_paterno)
            page.keyboard.press("Tab"); page.keyboard.type(apellido_materno)
            page.keyboard.press("Tab"); page.keyboard.type(nombre_paciente)

            if fecha_nac:
                partes = fecha_nac.replace("-", "/").split("/")
                if len(partes) == 3:
                    dia_v, mes_v, ano_v = partes[0].strip(), partes[1].strip(), partes[2].strip()
                    L(f"  Fecha nacimiento detectada (ignorada temporalmente): {dia_v}/{mes_v}/{ano_v}; edad=0")
                else:
                    L(f"  Fecha no parseable '{fecha_nac}' (ignorada temporalmente); edad=0")
            edad_ingreso = edad_para_ingreso(edad_val, fecha_nac)
            L(f"  Edad a ingresar: {edad_ingreso}")
            try:
                loc = page.locator("#edad").first
                loc.fill(""); page.wait_for_timeout(200)
                loc.type(edad_ingreso, delay=60)
            except Exception as e:
                L(f"  Fallback Tab para #edad: {e}")
                try:
                    for _ in range(5): page.keyboard.press("Tab")
                    page.keyboard.type(edad_ingreso)
                except Exception: pass

            if sexo_val == "M":
                L("  Sexo: Masculino")
                try: page.select_option("#sexo", "Masculino")
                except Exception as e: L(f"  #sexo error: {e}")
            else:
                L("  Sexo: vacío → sistema asigna Femenino automáticamente")

            page.click("#NuevoCliente"); time.sleep(3)
            if modal_vis(page):
                titulo, _ = leer_modal(page)
                if "ya existe" in titulo.lower() or "base de datos" in titulo.lower():
                    L("  Paciente ya existe; reintentare seleccion exacta")
                    for _ in range(2):
                        cerrar_esc(page)
                    return "existe"
                L(f"  Modal creando paciente: '{titulo}'")
                cerrar_ok(page)
                return "modal"
            L("  Paciente creado")
            return "creado"

        def seleccionar_paciente(page, pac) -> bool:
            nombre = pac.get("nombre", "").strip()
            if not nombre:
                return False

            # 1) Buscar tal cual esta escrito en la lista
            escribir(page, "#nuevo_cliente", nombre, delay=85)
            if autocomplete(page, nombre, t=12000, exacto=True):
                return True

            # 2) Buscar con punto final (variante ya registrada en el sistema)
            nombre_pto = nombre_con_punto(nombre)
            escribir(page, "#nuevo_cliente", nombre_pto, delay=85)
            if autocomplete(page, nombre_pto, t=12000, exacto=True):
                return True

            # 3) No existe -> crear paciente nuevo, siempre con punto final
            pac_pto = pac.copy()
            pac_pto["nombre"] = nombre_pto
            L(f"  No existe '{nombre}' ni '{nombre_pto}'; creare paciente nuevo: {nombre_pto}")
            crear_paciente(page, pac_pto)
            time.sleep(1)
            escribir(page, "#nuevo_cliente", nombre_pto, delay=85)
            if autocomplete(page, nombre_pto, t=14000, exacto=True):
                return True

            L(f"  No pude seleccionar paciente exacto: {nombre}")
            return False

        def ingresar_campos(page, pac, ing):
            tag = "  "
            nombre   = pac.get("nombre","")
            control  = num_a_ctrl(pac.get("numero",""))
            estudios = pac.get("estudios",[])
            L(f"  Paciente: {nombre}")
            if not seleccionar_paciente(page, pac):
                raise RuntimeError(f"No encontre/cree paciente exacto: {nombre}")
            time.sleep(0.6)
            L(f"  Doctor: {ing['doctor']}")
            escribir(page,"#nuevo_medico", ing["doctor"])
            if not autocomplete(page, ing["doctor"]): L("  Doctor no encontrado")
            page.fill("#observaciones", ing["observacion"]); time.sleep(0.2)
            try: page.select_option("#empresa", value=str(ing["empresa"])); L(f"  Empresa: {ing['empresa']}")
            except Exception as e: L(f"  Empresa error: {e}")
            time.sleep(0.3)
            page.fill("#controlInterno", control); time.sleep(0.2)
            page.fill("#procedencia", str(ing["procedencia"])); time.sleep(0.2)
            L("  Esperando campo estudios...")
            esperar_hab(page,"#AgregarEstudios")
            agregados = 0
            for est in estudios:
                L(f"{tag}Estudio: {est}")
                try:
                    page.wait_for_selector("#AgregarEstudios:not([disabled])", timeout=5000)
                    escribir(page, "#AgregarEstudios", est, delay=55)
                    if autocomplete(page, est, t=4000, estudio=True):
                        agregados += 1
                        # Esperar a que el sistema procese la selección
                        time.sleep(0.8)
                        # Verificar que no se haya recargado la página
                        try:
                            page.wait_for_selector("#AgregarEstudios", timeout=3000)
                        except PWT:
                            L(f"{tag}Página recargó tras agregar {est} — reingresando campos...")
                            # La página se recargó, hay que re-llenar todo
                            break
                        # Limpiar el campo de forma segura (sin fill directo)
                        try:
                            page.wait_for_selector("#AgregarEstudios:not([disabled])", timeout=3000)
                            campo = page.locator("#AgregarEstudios")
                            campo.click()
                            page.keyboard.press("Control+a")
                            page.keyboard.press("Delete")
                            time.sleep(0.3)
                        except Exception:
                            pass
                    else:
                        L(f"{tag}No encontrado: {est}")
                except PWT:
                    L(f"{tag}Campo deshabilitado: {est}")
            if agregados == 0: L("  Ningun estudio agregado")

        def guardar(page, pac, ing):
            for intento in range(1, MAX_INT+1):
                L(f"  Guardando ({intento}/{MAX_INT})...")
                page.click("#imprimir"); time.sleep(2.5)
                if not modal_vis(page):
                    L("  Guardado OK")
                    for _ in range(3): page.keyboard.press("Escape"); time.sleep(0.3)
                    return True
                titulo, sub = leer_modal(page)
                try: es_exito = page.locator(".swal2-icon.swal2-success").is_visible(timeout=800)
                except: es_exito = False
                if es_exito or any(p in titulo.lower() for p in ["guardad","exito","correcto","registr"]):
                    L("  Ingresado correctamente"); cerrar_esc(page); return True
                if "doctor" in sub.lower() or "doctor" in titulo.lower():
                    L("  Sin doctor reseleccionando..."); cerrar_ok(page)
                    escribir(page,"#nuevo_medico", ing["doctor"]); autocomplete(page, ing["doctor"]); continue
                if "faltan" in titulo.lower() or "campos" in titulo.lower():
                    cerrar_ok(page)
                    try: filas = page.locator("table tbody tr").count(); gran = page.locator("#gran_total").input_value(timeout=1000)
                    except: filas, gran = -1,"?"
                    if filas == 0 or gran == "0.00":
                        L("  Faltan estudios reagregando...")
                        esperar_hab(page,"#AgregarEstudios")
                        for est in pac.get("estudios",[]):
                            page.wait_for_selector("#AgregarEstudios:not([disabled])",timeout=4000)
                            escribir(page,"#AgregarEstudios",est,delay=50)
                            if autocomplete(page,est,t=3000, estudio=True): time.sleep(0.3); page.fill("#AgregarEstudios","")
                    else:
                        L("  Falta paciente reseleccionando...")
                        if not seleccionar_paciente(page, pac):
                            return False
                    continue
                L(f"  Modal desconocido: '{titulo}'"); cerrar_ok(page); time.sleep(1)
            L(f"  Fallo tras {MAX_INT} intentos"); return False

        with sync_playwright() as pw:
            browser = pw.chromium.launch(headless=False)
            page    = browser.new_page()
            L("Login...")
            page.goto(LAB_URL); esperar(page,"#ingUsuario")
            page.fill("#ingUsuario", LAB_USER)
            page.fill('input[name="ingPassword"]', LAB_PASS)
            page.click('button:has-text("Ingresar")'); time.sleep(4)
            esperar(page,"i.fa-file")
            page.locator("i.fa-file").first.click(force=True); time.sleep(2)
            manejar_apertura_caja(page, L)
            L("En modulo de ingreso\n")

            idx = idx_inicio
            while idx < len(self.cola):
                if self.detener_bot: L("Detenido"); break
                hoja = self.cola[idx]
                if hoja["estado"] != "validado":
                    L(f"'{hoja['nombre']}' no validada — deteniendo"); break
                data      = json.loads(pathlib.Path(hoja["json_path"]).read_text(encoding="utf-8"))
                pacientes = data["pacientes"]; ingreso = data["ingreso"]
                total = len(pacientes); ok_count = 0; fallidos = []
                hoja["estado"] = "ingresando"
                self._actualizar_lista()
                L(f"\n{'='*48}\n  BOT: {hoja['nombre']} — {total} pac\n{'='*48}")
                for i, pac in enumerate(pacientes, 1):
                    if self.detener_bot or page.is_closed(): break
                    L(f"  [{i}/{total}] {pac.get('nombre','?')}")
                    try:
                        ingresar_campos(page, pac, ingreso)
                        ok = guardar(page, pac, ingreso)
                        if ok: ok_count += 1
                        else:  fallidos.append(pac.get("nombre","?"))
                    except Exception as e:
                        L(f"  Error: {e}"); fallidos.append(pac.get("nombre","?"))
                        try: page.goto(LAB_URL); time.sleep(2)
                        except: pass
                    time.sleep(T_PAC)
                resultado = {"ok":ok_count,"total":total,"fallidos":fallidos}
                L(f"\n  OK: {hoja['nombre']}: {ok_count}/{total}")
                if fallidos: L(f"  Fallidos: {', '.join(fallidos)}")
                self._archivar_hoja(hoja, resultado)
                L("  Movida al historial")
                L("  Etiquetas: pendientes — saca desde Historial manualmente\n")
                if self.detener_bot: break
            if not page.is_closed(): browser.close()

